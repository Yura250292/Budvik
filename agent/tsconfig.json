{
  "compilerOptions": {
    "target": "ES2022",
    // CommonJS, а не ESM: node-cron і better-sqlite3 — CJS-пакети, які
    // покладаються на __dirname/require. Агент — самостійний процес,
    // тож ESM тут не дає нічого, крім проблем зі збіркою.
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true,
    "paths": {
      // Контракт обміну імпортується напряму з коду сайту — несумісність
      // агента й ingest ловиться компілятором, а не в проді.
      "@contract": ["../src/lib/sync-ingest/types.ts"]
    }
  },
  "include": ["src/**/*.ts", "../src/lib/sync-ingest/types.ts"]
}
