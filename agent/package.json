{
  "name": "budvik-sync-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Агент синхронізації 1С → Budvik. Встановлюється як служба Windows на сервері 1С, читає дані лише на читання і надсилає їх на сайт.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "once": "tsx src/index.ts --once",
    "preview": "tsx src/index.ts --once --preview",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/agent.cjs --external:better-sqlite3",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "node-cron": "^3.0.3",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
