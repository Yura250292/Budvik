/**
 * Як виглядає блок прогнозу в трьох станах — без бази й без моделі.
 *
 * Планів на місяць у базі може не бути місяцями (на вересень 2026 їх
 * немає жодного), тож гілки «план закривається» і «бонус спрацює» інакше
 * ніхто не побачить до першого заведеного плану. Дані тут вигадані
 * НАВМИСНО: перевіряємо саме формат — смужку, вердикт, відмінки.
 *
 *   npx tsx scripts/assistant-forecast.mts
 */

import { forecastBlock } from "../src/lib/assistant/answers";
import type { MonthForecast } from "../src/lib/assistant/facts/forecast";

const metric = (over: Partial<MonthForecast["показники"][number]> = {}) => ({
  ключ: "revenue" as const,
  назва: "Оборот",
  факт: 421_000,
  темп_на_день: 14_000,
  прогноз: 840_000,
  минулий_місяць: 780_000,
  зміна_до_минулого_відсотків: 7.7,
  план: 0,
  виконання_відсотків: null,
  прогнозоване_виконання_відсотків: null,
  треба_на_день: null,
  лишилось_добрати: null,
  ...over,
});

const base: MonthForecast = {
  місяць: "2026-09",
  минулий_місяць: "2026-08",
  днів_минуло: 15,
  днів_усього: 30,
  днів_лишилось: 15,
  показники: [metric()],
  бонуси: [],
  примітка: "плану на цей місяць немає — орієнтир минулий місяць",
};

const cases: Array<[string, MonthForecast]> = [
  ["БЕЗ ПЛАНУ", base],
  [
    "ПЛАН НЕ ДОТЯГУЄ",
    {
      ...base,
      примітка: null,
      показники: [
        metric({
          план: 1_000_000,
          виконання_відсотків: 42.1,
          прогнозоване_виконання_відсотків: 84,
          треба_на_день: 38_600,
          лишилось_добрати: 579_000,
        }),
      ],
      бонуси: [{ правило: "Бонус 5 000 ₴ за план", поріг_відсотків: 100, прогноз_відсотків: 84, спрацює: false }],
    },
  ],
  [
    "ПЛАН ІЗ ПЕРЕВИКОНАННЯМ",
    {
      ...base,
      примітка: null,
      показники: [
        metric({
          прогноз: 1_150_000,
          план: 1_000_000,
          виконання_відсотків: 57.5,
          прогнозоване_виконання_відсотків: 115,
          треба_на_день: null,
          лишилось_добрати: 0,
        }),
      ],
      бонуси: [{ правило: "Бонус 5 % за план", поріг_відсотків: 100, прогноз_відсотків: 115, спрацює: true }],
    },
  ],
];

for (const [title, f] of cases) {
  console.log(`\n──── ${title} ────`);
  console.log(forecastBlock(f).join("\n"));
}
