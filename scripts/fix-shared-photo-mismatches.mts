/**
 * Спільні фото, що показують не той товар — суцільний перебір.
 *
 * Одне фото на кілька карток — звичайна річ у каталогах виробників: ряд
 * типорозмірів має один знімок. Проблема в тому, що парсер бере верхнє фото
 * сторінки й вішає його на ВСЮ таблицю під ним, а на сторінці часто стоїть
 * не один товар. Тоді чуже фото їде на десятки карток одразу.
 *
 * Як шукали (09.09.2026): усі 175 фото, що стоять на 3+ картках (1312 карток),
 * перебрано двома ситами.
 *   1) Автоматичне: фото, що стоїть на товарах РІЗНИХ груп каталогу
 *      (Product.typeKey) — 11 знахідок, з них 9 справжніх промахів.
 *   2) Око по контактних листах — те, чого перше сито не бачить: промах
 *      усередині однієї групи (рулетка проти кутника, шпатель проти пензля,
 *      ключ ріжковий проти ріжково-накидного) — ще 6 знахідок.
 *
 * Нижче для кожного фото перелічено, ЩО НА НЬОМУ НАСПРАВДІ, — решті карток
 * фото знімаємо. Не підмінюємо сусіднім: у більшості випадків рідного знімка
 * немає ніде, а поставити схожий — це той самий обман, лише тихіший. Порожня
 * картка чесна; список того, що потребує фото, лишається в звіті.
 *
 * Запуск:
 *   npx tsx --env-file=.env scripts/fix-shared-photo-mismatches.mts           # звіт
 *   npx tsx --env-file=.env scripts/fix-shared-photo-mismatches.mts --apply   # виправити
 */
import fs from "node:fs";
import { PrismaClient } from "@prisma/client";

const prisma = new PrismaClient();
const APPLY = process.argv.includes("--apply");

/** Фото → артикули, які на ньому справді зображені (решта втрачає фото). */
const KEEP: { file: string; keep: string[]; shot: string }[] = [
  // --- знайшло сито по групах каталогу ---
  { file: "830310.jpg", shot: "свердла трубчаті з алмазним напиленням",
    keep: ["830310","830311","830312","830313","830314","830315","830316","830317","830318","830319","830320","830321","830322","830324","830325","830326","830327","830328","830330","830331","830332","830333","830335","830336","830337","830338"] },
  { file: "819051.jpg", shot: "подовжувач для коронок SDS+ (хвостовик із різьбою)",
    keep: ["819051","819052","819053","819054","819055"] },
  { file: "257018.jpg", shot: "ключ-тріскавка з металевою ручкою",
    keep: ["257016","257017","257018"] },
  { file: "830403.jpg", shot: "щітка чаша латуневий дріт",
    keep: ["830403","830404","830414","830420","830424","830425","830426","830427","830428"] },
  { file: "828120.jpg", shot: "губка шліфувальна двостороння",
    keep: ["828120","828121","828122","828123","828124","828125","828126","828127","828128"] },
  { file: "320192.jpg", shot: "киянка гумова з фібергласовою рукояткою",
    keep: ["320184","320185","320186","320189","320190","320191","320192","320193","320194"] },
  { file: "310712.jpg", shot: "знімачі стопорних кілець Puller",
    keep: ["310712","310713","310714","310715"] },
  { file: "829075.jpg", shot: "диск відрізний по металу в кейсі 125×1,6 (10 шт)",
    keep: ["829075","829078"] },
  { file: "257120.jpg", shot: "подовжувач гнучкий CrV",
    keep: ["257120"] },
  { file: "550391.jpg", shot: "ножиці для трави",
    keep: ["550390"] },
  // --- знайшло око ---
  { file: "500271.jpg", shot: "кутник і лінійка (розворот вимірювального інструменту)",
    keep: [] },
  { file: "257107.jpg", shot: "вороток L-подібний",
    keep: ["257107","257108"] },
  { file: "470307.jpg", shot: "пензлі флейцеві в упаковці",
    keep: [] },
  { file: "201906.jpg", shot: "ключ ріжковий двосторонній (обидва кінці відкриті)",
    keep: [] },
  { file: "830098.jpg", shot: "диск пильний по дереву з твердосплавними напайками",
    keep: ["830098","830099"] },
  { file: "699920.jpg", shot: "зварювальний дріт у бухті",
    keep: ["699920"] },
  // --- те саме око, але по фото, що стоять рівно на двох картках ---
  { file: "252108.jpg", shot: "розворот ключів ріжково-накидних (а не набір насадок)",
    keep: [] },
  { file: "951526.jpg", shot: "розворот аерозолів СИЛА (літієве мастило, очищувач)",
    keep: [] },
  { file: "202506.jpg", shot: "набір шестигранників",
    keep: ["202506"] },
  { file: "960611.jpg", shot: "автомобільний холодильник",
    keep: ["960540"] },
];

const plan: { sku: string; name: string; image: string; file: string; shot: string }[] = [];
for (const g of KEEP) {
  const rows = await prisma.product.findMany({
    where: { isActive: true, image: { endsWith: `/${g.file}` } },
    select: { id: true, sku: true, name: true, image: true },
    orderBy: { sku: "asc" },
  });
  const drop = rows.filter((r) => !g.keep.includes(r.sku ?? ""));
  console.log(`\n${g.file} — на фото: ${g.shot}`);
  console.log(`   лишається ${rows.length - drop.length}, знімаємо ${drop.length}`);
  for (const r of drop) {
    console.log(`     ✗ ${r.sku}  ${r.name.slice(0, 66)}`);
    plan.push({ sku: r.sku!, name: r.name, image: r.image!, file: g.file, shot: g.shot });
  }
}

console.log(`\nВсього зняти фото: ${plan.length} карток`);
if (!APPLY) {
  console.log("Проба без змін. Запустіть із --apply, щоб застосувати.");
  await prisma.$disconnect();
  process.exit(0);
}

/*
  Зліпок ДОПИСУЄМО, а не перезаписуємо.

  Перший прогін зняв 119 фото, другий (з дописаними чотирма групами) — ще 6,
  і перезапис лишив у файлі тільки останню шістку: історія перших 119 карток
  зникла, відновлювати довелось із каталожного index.json. Дозапис робить
  повторний прогін безпечним.
*/
const stamp = new Date().toISOString().slice(0, 10);
const backup = `scripts/backup-shared-photo-mismatches-${stamp}.json`;
const prev: unknown[] = fs.existsSync(backup) ? JSON.parse(fs.readFileSync(backup, "utf8")) : [];
fs.writeFileSync(backup, JSON.stringify([...prev, ...plan.map((p) => ({ ...p, newImage: null }))], null, 1));
console.log(`Злі́пок старих фото: ${backup} (${prev.length} + ${plan.length})`);

for (const p of plan) {
  await prisma.product.updateMany({ where: { sku: p.sku }, data: { image: null } });
}
console.log(`Оновлено карток: ${plan.length}`);
await prisma.$disconnect();
