import { classifyCostItem } from "../src/lib/finance/cost-items";

const fails: string[] = [];
function check(name: string, ok: boolean, got: unknown) {
  console.log(`${ok ? "ok  " : "FAIL"} ${name} — ${JSON.stringify(got)}`);
  if (!ok) fails.push(name);
}

