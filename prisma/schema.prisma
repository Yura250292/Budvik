generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SALES
  WAREHOUSE
  DRIVER
  WHOLESALE
  CLIENT
}

enum WholesaleApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BusinessType {
  PRODUCTION
  SHOP
  SUBDISTRIBUTOR
  MARKET_POINT
  OTHER
}

enum OrderStatus {
  PENDING
  PAID
  PACKAGING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum BoltsType {
  EARNED
  SPENT
}

/// Спосіб отримання роздрібного замовлення з сайту. ERP-шний DeliveryMethod
/// (DRIVER / SALES_REP_PICKUP / SELF_PICKUP) описує інший контур — рух накладної
/// 1С, а не вибір покупця в кошику, тому тут окремий вузький enum.
enum RetailDelivery {
  DELIVERY
  PICKUP
}

/// Спосіб оплати роздрібного замовлення. Поки єдиний — при отриманні;
/// enum, а не boolean, щоб онлайн-оплата колись додалась без міграції даних.
enum PaymentMethod {
  COD
}

// ========== ERP Enums ==========

enum DocumentStatus {
  DRAFT
  CONFIRMED
  PACKING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

// Замовлення і реалізація живуть в одній таблиці SalesDocument, бо це той
// самий набір полів. Розрізняє їх docType: аналітика торгових рахує лише
// реалізації (фактично відвантажене), ERP працює із замовленнями.
enum SalesDocType {
  ORDER // ЗаказПокупателя з 1С або документ, створений на сайті
  REALIZATION // РеализацияТоваровУслуг — фактичне відвантаження
  RETURN // ВозвратТоваровОтПокупателя — повернення від покупця
}

enum DeliveryMethod {
  DRIVER
  SALES_REP_PICKUP
  SELF_PICKUP
}

enum DeliveryRouteStatus {
  /// Чернетка логіста: складається, водій її НЕ бачить
  PLANNED
  /// Передано водію — з'являється на планшеті
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DeliveryStopStatus {
  PENDING
  LOADED
  DELIVERED
  FAILED
}

/// Що водій робить у точці. DELIVERY — звичайна доставка з накладною;
/// PICKUP і ERRAND — бонусні поїздки без накладної (забрати товар,
/// відвезти ремонт на пошту), які оплачуються окремою сумою.
enum DeliveryStopKind {
  DELIVERY
  PICKUP
  ERRAND
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
}

enum CounterpartyType {
  SUPPLIER
  CUSTOMER
  BOTH
}

enum WarehouseShiftStatus {
  OPEN
  CLOSED
}

enum WarehouseReportStatus {
  PENDING // фото збережено, чекає на розпізнавання
  PROCESSING // воркер узяв у роботу
  DONE // розпізнано успішно
  FAILED // помилка розпізнавання
}

enum SalesTripStatus {
  OPEN // поїздка триває
  CLOSED // торговий завершив і підтвердив кінцевий одометр
  ABANDONED // закрито автоматично — торговий не завершив поїздку
}

/// Період, за який ставиться план і рахується його виконання.
enum PlanPeriod {
  DAY
  WEEK
  MONTH
  QUARTER
}

/// Що саме вимірює план. Одна модель на всі види цілей — інакше під
/// кожен новий показник довелося б заводити окрему таблицю.
enum PlanMetric {
  COLLECTED_AMOUNT // зібрані гроші — головний показник
  REVENUE // оборот (відвантажено)
  PROFIT // валовий прибуток
  SKU_COUNT // кількість позицій — «якість опрацювання точки»
  CLIENTS_COUNT // унікальних клієнтів
  CHECKPOINTS // відвідувань за даними бота
  OVERDUE_RATIO // частка простроченої дебіторки (менше = краще)
}

/// Як рахується винагорода. Дозволяє комбінувати кілька правил в одній
/// схемі: відсоток + бонус за план + утримання за прострочку.
enum MotivationRuleType {
  PERCENT_OF_PROFIT // % від прибутку в зібраних грошах
  PERCENT_OF_COLLECTED // % від суми зібраних грошей
  PLAN_BONUS_FIXED // фіксована сума за виконання плану
  PLAN_BONUS_PERCENT // % від бази, якщо план виконано
  TIERED_PERCENT // ставка залежить від % виконання плану
  OVERDUE_PENALTY // утримання за прострочену дебіторку
}

/// Дебіторка: робоча (строк не минув) чи прострочена.
enum ReceivableBucket {
  CURRENT // строк оплати ще не настав
  OVERDUE_30
  OVERDUE_60
  OVERDUE_90
  OVERDUE_90_PLUS
}

enum OdometerSource {
  AI // Gemini розпізнав, торговий підтвердив
  MANUAL // торговий увів число руками (AI не спрацював)
  CORRECTED // AI розпізнав, але торговий виправив — головна метрика якості AI
}

/// Зона точки вигрузки для зарплати водія: місто дорожче за область.
/// «Місто» — Львів у межах об'їзної; усе за нею — область.
enum DeliveryZone {
  CITY
  OBLAST
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  password     String?
  name         String
  phone        String?
  role         Role    @default(CLIENT)
  boltsBalance Float   @default(0)

  /// Колір торгового на мапі напрямків (#RRGGBB); null — детермінований fallback з палітри
  color String?

  /// Фото профілю (URL у R2); null — показуємо ініціал на кольоровому кружечку
  avatarUrl String?

  // Telegram (бот складу Budvik_Sklad)
  telegramId       String? @unique // Telegram user id як рядок — ID перевищують 2^31
  telegramUsername String? // @username на момент прив'язки, довідково

  /// Код у QR-лінку торгового (/r/[code]). Лише для role=SALES, генерується
  /// при першому відкритті QR — щоб не роздавати коди тим, хто ними не користується.
  refCode String? @unique

  /// Торговий, чий QR привів цього клієнта. Ставиться один раз (перший виграє)
  /// і далі не перезаписується — інакше чужий QR «перехоплював» би клієнта.
  /// Окреме поле, а не SalesRepClient: та таблиця про контрагентів 1С,
  /// роздрібний покупець сайту в ній не існує.
  referredBySalesRepId String?
  referredBySalesRep   User?   @relation("referredClients", fields: [referredBySalesRepId], references: [id], onDelete: SetNull)
  referredClients      User[]  @relation("referredClients")
  attributedOrders     Order[] @relation("orderSalesRep")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders                Order[]
  boltsTransactions     BoltsTransaction[]
  wholesaleApplications WholesaleApplication[]

  companyId String?
  company   WholesaleCompany? @relation(fields: [companyId], references: [id])

  // Link wholesale user to their Counterparty record
  counterpartyId     String?
  linkedCounterparty Counterparty? @relation("UserLinkedCounterparty", fields: [counterpartyId], references: [id])

  // ERP relations
  purchaseOrdersCreated  PurchaseOrder[]    @relation("purchaseOrderCreator")
  salesDocumentsCreated  SalesDocument[]    @relation("salesDocCreator")
  salesRepSales          SalesDocument[]    @relation("salesRepSales")
  invoicesCreated        Invoice[]          @relation("invoiceCreator")
  commissionRates        CommissionRate[]   @relation("commissionRates")
  commissionRecords      CommissionRecord[] @relation("commissionRecords")
  aiInsightReports       AiInsightReport[]  @relation("aiInsightRep")
  savedAiReports         SavedAiReport[]    @relation("savedAiReportRep")
  savedAiReportsAuthored SavedAiReport[]    @relation("savedAiReportAuthor")

  // Delivery relations
  driverRoutes   DeliveryRoute[] @relation("driverRoutes")
  createdRoutes  DeliveryRoute[] @relation("routeCreator")
  assignedRoutes DeliveryRoute[] @relation("routeAssigner")
  savedRoutes    SavedRoute[]    @relation("savedRoutes")

  // Sales rep profile
  salesRepRegions    SalesRepRegion[]
  salesRepClients    SalesRepClient[]
  salesRepCategories SalesRepCategoryAccess[]

  notifications Notification[]

  // Warehouse (Telegram bot) relations
  warehouseShifts        WarehouseShift[]       @relation("warehouseShiftWorker")
  warehouseReports       WarehouseReport[]      @relation("warehouseReportWorker")
  warehouseLinksApproved WarehouseLinkRequest[] @relation("warehouseLinkApprover")

  // Sales rep trips (той самий Telegram бот, роль SALES)
  salesTrips       SalesTrip[]       @relation("salesTripRep")
  salesCheckpoints SalesCheckpoint[] @relation("salesCheckpointRep")
  salesTrackPoints SalesTrackPoint[] @relation("salesTrackRep")

  // Плани та мотивація
  salesPlans             SalesPlan[]              @relation("salesPlanRep")
  salesPlansCreated      SalesPlan[]              @relation("salesPlanAuthor")
  motivationAssignments  MotivationAssignment[]   @relation("motivationRep")
  paymentAllocations     PaymentAllocation[]      @relation("paymentAllocations")
  payrollEntries         MotivationPayrollEntry[] @relation("payrollEntries")
  individualTermsEntries IndividualTermsEntry[]   @relation("individualTermsEntries")

  // Маршрути торгових і авто
  routeTemplatesCreated RouteTemplate[]   @relation("routeTemplateAuthor")
  routeAssignments      RouteAssignment[] @relation("routeAssignmentRep")
  salesVehicle          SalesVehicle?     @relation("salesVehicle")

  // Точки для розпрацювання на карті клієнтів
  assignedProspects ProspectClient[] @relation("prospectAssignedRep")
  createdProspects  ProspectClient[] @relation("prospectAuthor")
  clientComments    ClientComment[]  @relation("clientCommentAuthor")

  /// Ref_Key водія в 1С — прив'язка акаунта до маршрутних листів.
  /// Поле, а не окрема таблиця: водіїв одиниці, зв'язок 1:1 і без історії
  /// перепризначень (той самий підхід, що counterpartyId вище).
  driver1CExternalId String? @unique

  routeSheets          RouteSheet[]  @relation("driverRouteSheets")
  driverBonuses        DriverBonus[] @relation("driverBonusDriver")
  driverBonusesCreated DriverBonus[] @relation("driverBonusAuthor")

  dashboardLayout UserDashboardLayout?
  dashboardNotes  UserDashboardNote[]

  // Планшет у машині: веб-трек і відмітки візитів
  trackSessions TrackSession[]    @relation("trackSessionUser")
  trackPoints   TrackPoint[]      @relation("trackPointUser")
  deviceTokens  DeviceToken[]     @relation("deviceTokenUser")
  heartbeats    DeviceHeartbeat[] @relation("heartbeatUser")
  shifts        Shift[]           @relation("shiftUser")
  visits        Visit[]           @relation("visitUser")

  // Застосунок покупця
  pushTokens PushToken[]    @relation("pushTokenUser")
  wishlist   WishlistItem[] @relation("wishlistUser")

  // Інкасація: свої здачі та підтвердження чужих
  cashHandovers     CashHandover[] @relation("cashHandoverDriver")
  cashConfirmations CashHandover[] @relation("cashHandoverConfirmedBy")

  @@index([referredBySalesRepId])
}

/// Розкладка віджетів дашборду адмінки. Окрема модель, а не поле в User:
/// її можна скинути одним рядком, не чіпаючи гарячу таблицю користувачів.
model UserDashboardLayout {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// { version: 1, widgets: [{ id, type, size, order }] }
  layout    Json
  updatedAt DateTime @updatedAt
}

/// Особисті нотатки-задачі з віджета дашборду. Рядками, а не одним Json:
/// так можна позначити зроблене й відсортувати, не переписуючи весь блок.
model UserDashboardNote {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  text String
  done Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Віджет завжди читає нотатки одного користувача, свіжі згори.
  @@index([userId, done, createdAt])
}

model Category {
  id             String                   @id @default(cuid())
  name           String
  slug           String                   @unique
  image          String?
  products       Product[]
  salesRepAccess SalesRepCategoryAccess[]

  // Синхронізація з 1С: дерево груп номенклатури дзеркалиться сюди,
  // але навігація сайту лишається ручною (див. src/lib/category-tree.ts)
  externalId String?    @unique // Ref_Key групи в 1С
  source     String? // "1C" — категорія прийшла з 1С, null — ручна
  parentId   String?
  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryTree")
}

model Product {
  id             String   @id @default(cuid())
  sku            String?  @unique
  name           String
  slug           String   @unique
  description    String
  price          Float
  wholesalePrice Float?
  /// Роздріб не з 1С, а розрахований з опту (× Brand.retailMarkup): у 1С для
  /// цього товару немає ціни «6.МАГАЗИНИ». Скидається, щойно вона зʼявиться.
  priceDerived   Boolean  @default(false)
  image          String?
  stock          Int      @default(0)
  isActive       Boolean  @default(true)
  priority       Int      @default(0)
  isPromo        Boolean  @default(false)
  promoPrice     Float?
  promoLabel     String?
  // Кратність: товар продається пачками, замовляти можна лише 10, 20, 30...
  // Джерело — назва з 1С («кратно 10шт», «Уп. 5 шт»), розбирає src/lib/pack-qty.ts.
  // Квадратні дужки [N] у назві НЕ кратність, а кількість у ящику (там буває [1] і [500]).
  packQty        Int? // 1/null — поштучно
  // Штрихкоди з 1С — для пошуку камерою в застосунку.
  //
  // Масив, а не одне поле: в 1С у номенклатури буває кілька штрихкодів
  // (упаковка, ящик, старий код постачальника), і будь-який із них може
  // виявитись саме тим, що надрукований на коробці в руках у покупця.
  barcodes       String[] @default([])
  // Tool specification fields (optional)
  powerWatts     Int? // Потужність (Вт)
  rpm            Int? // Обороти (об/хв)
  discDiameterMm Int? // Діаметр диска (мм)
  chuckMm        Float? // Патрон (мм)
  toolType       String? // drill | grinder | saw | jigsaw | sander
  weightKg       Float? // Вага (кг)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categoryId String
  category   Category          @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  embedding  ProductEmbedding?

  // Бренд для планів і мотивації. Окреме поле, а не евристика по назві:
  // «перше слово» дає хибні збіги на 41 тис. товарів.
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  // Sync fields
  syncedAt   DateTime? // Коли останній раз ЗМІНЕНО даними з 1С
  syncSource String? // "1C" — позначка що дані прийшли з 1С
  externalId String?   @unique // Ref_Key (GUID) номенклатури в 1С — стабільний ключ зіставлення

  /// Коли ціну востаннє ПІДТВЕРДИВ повний зріз 1С — на відміну від syncedAt,
  /// який рухається лише коли значення змінилось.
  ///
  /// Потрібне, бо зріз цін віддає тільки позиції з ціною > 0: коли ціну в 1С
  /// прибирають, товар просто зникає з вивантаження, і без цієї мітки стара
  /// ціна лишалася б на вітрині назавжди. Звірка (reconcile-prices.ts) шукає
  /// саме за нею.
  priceSyncedAt DateTime?

  // ERP relations
  supplierProducts   SupplierProduct[]
  purchaseOrderItems PurchaseOrderItem[]
  salesDocumentItems SalesDocumentItem[]
  reservations       StockReservation[]
  locationStocks     LocationStock[]

  // Warehouse reports (лише довідковий матчинг, склад не змінюється)
  warehouseReportItems WarehouseReportItem[] @relation("warehouseItemProduct")

  @@index([brandId])
  // GIN — бо шукаємо `barcodes has "482..."`, а B-tree по масиву в цьому не помічний.
  @@index([barcodes], type: Gin)
}

model SeasonalPromo {
  id          String    @id @default(cuid())
  title       String // "Весняний розпродаж", "Зимові знижки"
  description String?
  season      String // spring, summer, autumn, winter, custom
  icon        String? // emoji
  color       String    @default("#FFD600") // accent color
  keywords    String[] // product name keywords to auto-match
  categoryIds String[] // category IDs to include
  productIds  String[] // manually pinned product IDs
  isActive    Boolean   @default(true)
  startDate   DateTime? // for custom date ranges
  endDate     DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum PromotionType {
  QUANTITY_PRICE // Ступінчасті ціни за кількістю
  AMOUNT_DISCOUNT // Знижка від суми замовлення (%)
  CASHBACK_BOLTS // Кешбек болтами (%)
  PRODUCT_DISCOUNT // Знижка на конкретні товари (%)
}

model Promotion {
  id          String        @id @default(cuid())
  name        String
  description String?
  type        PromotionType
  conditions  Json // масив тирів, залежить від типу
  productIds  String[]
  categoryIds String[]
  isActive    Boolean       @default(true)
  startDate   DateTime?
  endDate     DateTime?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

/// Токен відновлення пароля. Зберігаємо хеш, а не сам токен: витік дампа бази
/// інакше дав би змогу зайти в будь-який акаунт. Лишається невикористаним, поки
/// не підключено поштового провайдера — надсилати листа зараз нічим.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model ImportLog {
  id        String   @id @default(cuid())
  type      String
  filename  String
  status    String
  created   Int      @default(0)
  updated   Int      @default(0)
  skipped   Int      @default(0)
  errors    Int      @default(0)
  details   String?
  createdAt DateTime @default(now())
}

model Order {
  id String @id @default(cuid())

  /// Номер для людей: «№ 1043» замість хвоста cuid. autoincrement, бо номер
  /// потрібен саме послідовний і атомарний; DocumentSequence лишається для
  /// ERP-документів, де номер має префікс і власний лічильник по типах.
  orderNumber Int @unique @default(autoincrement())

  /// null — гостьове замовлення (оформлене без акаунта). Контактні дані такого
  /// замовлення живуть у полях нижче, а не в User.
  userId String?

  /// Контакти й доставка — знімок на момент оформлення, а не join до User:
  /// людина може замовити на іншу адресу чи інший телефон, ніж у профілі,
  /// а профіль потім змінити — минуле замовлення має лишитись як було.
  contactName    String?
  phone          String?
  city           String?
  address        String?
  deliveryMethod RetailDelivery @default(DELIVERY)
  paymentMethod  PaymentMethod  @default(COD)
  comment        String?

  /// Секрет для відстеження замовлення без акаунта: /order/[token].
  /// randomUUID — 122 біти, перебором не знайти.
  guestToken String? @unique

  totalAmount Float
  boltsUsed   Float       @default(0)
  boltsEarned Float       @default(0)
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  /// Знімок торгового на момент замовлення (з User.referredBySalesRepId).
  /// Саме знімок, а не join при читанні: якщо клієнта колись перепривʼяжуть,
  /// минулий оборот має лишитись за тим, хто його зробив.
  salesRepId String?
  salesRep   User?   @relation("orderSalesRep", fields: [salesRepId], references: [id], onDelete: SetNull)

  user  User?       @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([salesRepId])
  @@index([userId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  // Без цих індексів groupBy по productId на головній і будь-який join
  // позицій до замовлення — повний скан таблиці. Зараз вона мала, але
  // росте з кожним замовленням, і деградація була б непомітною до болю.
  @@index([orderId])
  @@index([productId])
}

