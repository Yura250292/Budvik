{
  "compilerOptions": {
    "target": "ES2018",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Скрипти в scripts/ запускаються через `node --experimental-strip-types`,
    // а він вимагає розширення в імпортах. Безпечно при noEmit.
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    // Агент 1С — окремий Node-проєкт із власним tsconfig (CommonJS, alias @contract).
    // Перевіряється командою `npm run typecheck` у папці agent.
    "agent",
    // Застосунок покупця — React Native з власним tsconfig (expo/tsconfig.base,
    // свій набір типів і той самий alias @/* на іншу теку). Без цього рядка
    // перевірка сайту намагається зібрати екрани RN зі своїми шляхами.
    "mobile"
  ]
}
