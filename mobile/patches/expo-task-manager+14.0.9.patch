+package expo.modules.taskManager;
+
+import android.content.Context;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.util.ArrayDeque;
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * ПАТЧ Budvik: чорна скринька диспетчера фонових завдань.
+ *
+ * 15.09.2026 трек трьох торгових стояв годинами, бо TaskService «забув» живий
+ * контекст JS і складав координати в чергу без читача. Встановити це вдалося
+ * лише статистикою по пульсах за 12 днів: сам диспетчер не лишає жодного сліду.
+ * Тут він його лишає — скільки подій доставлено напряму, скільки лягло в чергу,
+ * хто і коли реєстрував і знімав завдання, коли стерто реєстрацію контексту.
+ *
+ * Лічильники живуть у пам'яті процесу навмисно: вони описують саме той процес,
+ * який розбираємо. Журнал рідкісних подій переживає смерть процесу
+ * (SharedPreferences) — інакше «хто зняв завдання о 09:06» зникало б разом із
+ * процесом, що його зняв.
+ *
+ * Читає track-guard рефлексією (`snapshot`). На поведінку диспетчера це не
+ * впливає: кожен виклик загороджено, і падіння діагностики лишається тут.
+ */
+public final class BudvikTaskDiag {
+  private static final String PREFS = "budvik-task-diag";
+  private static final String KEY_LOG = "log";
+  /** Реєстрація завдання йде з кожним стартом запису, тож стеля з запасом на день. */
+  private static final int LOG_CAP = 150;
+
+  static final AtomicLong execDirect = new AtomicLong();
+  static final AtomicLong execQueued = new AtomicLong();
+  static final AtomicLong finished = new AtomicLong();
+  static final AtomicLong loadAppCalls = new AtomicLong();
+  static final AtomicLong invalidations = new AtomicLong();
+  static volatile long lastDirectAt = 0;
+  static volatile long lastQueuedAt = 0;
+  static volatile long lastFinishedAt = 0;
+  static volatile String lastDirectTask = "";
+  static volatile String lastQueuedTask = "";
+  private static volatile boolean sQueuedMode = false;
+  private static final long PROCESS_SEEN_AT = System.currentTimeMillis();
+
+  private static final ArrayDeque<String> sLog = new ArrayDeque<>();
+  private static boolean sLoaded = false;
+
+  private BudvikTaskDiag() {
+  }
+
+  /** Подію віддано живому контексту JS. У журнал — лише перехід із черги назад. */
+  static void direct(Context context, String taskName) {
+    execDirect.incrementAndGet();
+    lastDirectAt = System.currentTimeMillis();
+    lastDirectTask = String.valueOf(taskName);
+    if (sQueuedMode) {
+      sQueuedMode = false;
+      note(context, "dispatch", "знову напряму: " + taskName);
+    }
+  }
+
+  /** Контексту немає — подія лягла в чергу. У журнал — лише перша з серії. */
+  static void queued(Context context, String taskName, int queueSize) {
+    execQueued.incrementAndGet();
+    lastQueuedAt = System.currentTimeMillis();
+    lastQueuedTask = String.valueOf(taskName);
+    if (!sQueuedMode) {
+      sQueuedMode = true;
+      note(context, "dispatch", "у чергу, контексту немає: " + taskName + ", у черзі " + queueSize);
+    }
+  }
+
+  static void finished() {
+    finished.incrementAndGet();
+    lastFinishedAt = System.currentTimeMillis();
+  }
+
+  /** Рядок журналу: «мс|вид|подробиці». Нічого не кидає. */
+  static synchronized void note(Context context, String kind, String detail) {
+    try {
+      load(context);
+      String line = System.currentTimeMillis() + "|" + kind + "|" + (detail == null ? "" : detail);
+      if (line.length() > 300) {
+        line = line.substring(0, 300);
+      }
+      sLog.addLast(line);
+      while (sLog.size() > LOG_CAP) {
+        sLog.removeFirst();
+      }
+      if (context != null) {
+        JSONArray arr = new JSONArray();
+        for (String s : sLog) {
+          arr.put(s);
+        }
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putString(KEY_LOG, arr.toString()).apply();
+      }
+    } catch (Throwable ignored) {
+    }
+  }
+
+  /** Попередні процеси — спершу, потім позначка нового процесу. */
+  private static void load(Context context) {
+    if (sLoaded || context == null) {
+      return;
+    }
+    sLoaded = true;
+    try {
+      String raw = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getString(KEY_LOG, null);
+      ArrayDeque<String> merged = new ArrayDeque<>();
+      if (raw != null) {
+        JSONArray arr = new JSONArray(raw);
+        for (int i = 0; i < arr.length(); i++) {
+          merged.addLast(arr.optString(i));
+        }
+      }
+      merged.addLast(PROCESS_SEEN_AT + "|process|новий процес " + android.os.Process.myPid());
+      merged.addAll(sLog);
+      sLog.clear();
+      sLog.addAll(merged);
+      while (sLog.size() > LOG_CAP) {
+        sLog.removeFirst();
+      }
+    } catch (Throwable ignored) {
+    }
+  }
+
+  /** Хто кличе: кілька кадрів стеку поза системою й самим журналом. */
+  static String caller() {
+    try {
+      StringBuilder sb = new StringBuilder();
+      int n = 0;
+      for (StackTraceElement e : Thread.currentThread().getStackTrace()) {
+        String c = e.getClassName();
+        if (c.startsWith("java.") || c.startsWith("dalvik.") || c.startsWith("android.os.")
+          || c.startsWith("kotlin.") || c.equals(BudvikTaskDiag.class.getName())) {
+          continue;
+        }
+        if (sb.length() > 0) {
+          sb.append(" < ");
+        }
+        sb.append(c.substring(c.lastIndexOf('.') + 1)).append('.').append(e.getMethodName());
+        if (++n >= 5) {
+          break;
+        }
+      }
+      return sb.toString();
+    } catch (Throwable ignored) {
+      return "";
+    }
+  }
+
+  /** Повний знімок у JSON-рядку. Викликає track-guard рефлексією. */
+  public static String snapshot(Context context) {
+    JSONObject out = new JSONObject();
+    try {
+      JSONArray log = new JSONArray();
+      synchronized (BudvikTaskDiag.class) {
+        load(context);
+        for (String s : sLog) {
+          log.put(s);
+        }
+      }
+      out.put("processSeenAt", PROCESS_SEEN_AT);
+      out.put("execDirect", execDirect.get());
+      out.put("execQueued", execQueued.get());
+      out.put("finished", finished.get());
+      out.put("loadAppCalls", loadAppCalls.get());
+      out.put("invalidations", invalidations.get());
+      out.put("lastDirectAt", lastDirectAt);
+      out.put("lastDirectTask", lastDirectTask);
+      out.put("lastQueuedAt", lastQueuedAt);
+      out.put("lastQueuedTask", lastQueuedTask);
+      out.put("lastFinishedAt", lastFinishedAt);
+      out.put("queuedMode", sQueuedMode);
+      out.put("state", TaskService.budvikState(context));
+      out.put("log", log);
+    } catch (Throwable e) {
+      try {
+        out.put("error", String.valueOf(e));
+      } catch (Throwable ignored) {
+      }
+    }
+    return out.toString();
+  }
+}
