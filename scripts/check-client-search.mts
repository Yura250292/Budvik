/**
 * Пошук клієнта так, як його пише людина, а не як його завела 1С.
 *
 *   npx tsx --env-file=.env scripts/check-client-search.mts
 *
 * Навіщо. 23.09.2026 власник попросив маршрут на «Яцків Іван Теодорович
 * (Перемишляни)», і помічник відповів «не знайдено в базі». Клієнт там є —
 * «Яцьків Іван Теодорович (м.Перемишляни)». Розійшлося три речі, і кожна
 * окремо вбиває пошук:
 *
 *   - м'який знак і апостроф: «Яцків» не підрядок «Яцьків», а 1С пише
 *     апостроф трьома різними символами («Мар'яна», «Мар`ян», «Марʼяна»);
 *   - розділові знаки прилипають до слова: «(Перемишляни)» шукалося як
 *     «(Перемишлян», а в назві стоїть «(м.Перемишляни)»;
 *   - позначки «м.», «смт» займають слоти з п'яти слів, і місто, що йде
 *     останнім, випадало з пошуку зовсім.
 *
 * Найгірше з цього — не «не знайдено», а впевнена помилка: «Яцків» другою
 * спробою знаходив «Яцкуляк Марія (м.Турка)» і ставив у маршрут Турку.
 *
 * Лише читання бази. Імена — живі клієнти; якщо картку перейменують у 1С,
 * перевірка скаже про це прямо, а не мовчки пропустить.
 */

import { findClients, pickOneClient } from "../src/lib/assistant/facts/client-search";
import { prisma } from "../src/lib/prisma";

const fails: string[] = [];
function check(name: string, ok: boolean, got: unknown) {
  console.log(`${ok ? "ok  " : "FAIL"} ${name} — ${String(got)}`);
  if (!ok) fails.push(name);
}

const admin = await prisma.user.findFirst({ where: { role: "ADMIN" }, select: { id: true } });
if (!admin) {
  console.log("FAIL у базі немає ADMIN — нема від чийого імені шукати");
  process.exit(1);
}

async function picked(q: string): Promise<string> {
  return pickOneClient(await findClients(q, admin!.id, { limit: 4 }))?.name ?? "НІКОГО";
}

/* ── Яцьків: м'який знак, дужки, місто ─────────────────────────────── */

const YATS = /^Яцьків Іван Теодорович \(м\.Перемишляни\)$/;

for (const q of [
  "Яцків Іван Теодорович (Перемишляни)",
  "Яцків Іван Теодорович",
  "Яцків Перемишляни",
  "Яцьків Іван Теодорович (Перемишляни)",
  "Яцків м. Перемишляни",
  "яцків, перемишляни",
]) {
  const got = await picked(q);
  check(`«${q}» → Яцьків із Перемишлян`, YATS.test(got), got);
}

// Впевнена помилка гірша за «не знайдено»: Турка — інший кінець області.
const lone = await findClients("Яцків", admin.id, { limit: 4 });
check(
  "«Яцків» не підсовує Яцкуляк із Турки",
  !lone.some((h) => /Яцкуляк/.test(h.name)),
  lone.map((h) => h.name).join(" | ") || "порожньо"
);

/* ── Апостроф будь-яким символом ─────────────────────────────────── */

for (const q of ["Скалоцька Маряна Перемишляни", "Скалоцька Марʼяна Перемишляни", "Скалоцька Мар`яна Перемишляни"]) {
  const got = await picked(q);
  check(`«${q}» → Скалоцька з Перемишлян`, /Скалоцька.*Перемишлян/.test(got), got);
}

/* ── Місто останнім словом не губиться ───────────────────────────── */

// П'ять слів до міста: раніше «Перемишляни» випадало з ліміту, і вибір
// між Бібркою й Перемишлянами робило сортування за датою, а не запит.
const bibrka = await picked("ФОП Скалоцька Мар'яна Любомирівна (м. Бібрка)");
check("довгий запит із Бібркою → Бібрка", /Скалоцька.*Бібрк/.test(bibrka), bibrka);
const peremy = await picked("ФОП Скалоцька Мар'яна Любомирівна (смт Перемишляни)");
check("довгий запит із Перемишлянами → Перемишляни", /Скалоцька.*Перемишлян/.test(peremy), peremy);

/* ── Те, що працювало, працює й далі ─────────────────────────────── */

const soltiv = await picked("Солтівська Надя (м. Золочів)");
check("«Солтівська Надя (м. Золочів)» як і раніше", /^Солтівська Надя \(м\.Золочів\)$/.test(soltiv), soltiv);

await prisma.$disconnect();

if (fails.length) {
  console.log(`\n${fails.length} провалено: ${fails.join("; ")}`);
  process.exit(1);
}
console.log("\nусе гаразд");
