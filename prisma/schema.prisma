  totalAmount Float          @default(0)
  notes       String?
  confirmedAt DateTime?
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  externalId String? @unique // Ref_Key документа надходження в 1С

  supplier  Counterparty        @relation(fields: [supplierId], references: [id])
  createdBy User                @relation("purchaseOrderCreator", fields: [createdById], references: [id])
  items     PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  purchasePrice   Float

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
}

model SalesDocument {
  id             String         @id @default(cuid())
  // Не @unique: 1С нумерує замовлення і реалізації незалежними лічильниками,
  // тож той самий номер може прийти двічі. Унікальність — у @@unique нижче.
  number         String
  docType        SalesDocType   @default(ORDER)
  counterpartyId String?
  salesRepId     String?
  status         DocumentStatus @default(DRAFT)
  // ЗНАК: у документів RETURN totalAmount і quantity рядків ВІД'ЄМНІ.
  // У 1С вони додатні — мінус ставить сервер при прийомі (apply-documents.ts).
  // Завдяки цьому будь-який SUM() дає одразу чистий оборот, і жоден
  // майбутній запит не зможе «забути» відняти повернення.
  totalAmount    Float          @default(0)
  discountAmount Float          @default(0)
  profitAmount   Float          @default(0)
  notes          String?
  confirmedAt    DateTime?
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  deliveryMethod DeliveryMethod?
  deliveryNotes  String?

  externalId String? @unique // Ref_Key документа в 1С (унікальний незалежно від типу)

  counterparty    Counterparty?       @relation(fields: [counterpartyId], references: [id])
  salesRep        User?               @relation("salesRepSales", fields: [salesRepId], references: [id])
  createdBy       User                @relation("salesDocCreator", fields: [createdById], references: [id])
  items           SalesDocumentItem[]
  invoice         Invoice?
  commissions     CommissionRecord[]
  reservations    StockReservation[]
  deliveryStop    DeliveryStop?
  routeSheetStops RouteSheetStop[]    @relation("routeSheetStops")
  // Є ще частковий індекс "SalesDocument_client_recent_idx"
  // ("counterpartyId", "createdAt" DESC) з умовою SOURCE_FILTER — під картку
  // останніх замовлень клієнта. Prisma часткові індекси не вміє описувати,
  // тож він живе лише в міграції 20260812210000_client_order_idx. Не видаляти
  // його руками: без нього вибірка йде Seq Scan-ом по всій таблиці.

  @@unique([number, docType])
  @@index([docType, status, createdAt]) // під фільтр аналітики торгових
  // Пошук документів ОДНОГО клієнта. Без цього індексу кожен такий пошук
  // ішов Seq Scan-ом по всій таблиці, а запити, які питають про клієнта в
  // циклі, множили це на 3.7 тис. контрагентів: у debtDeltaByRep вийшло
  // 41 млн переглянутих рядків і 4 с на кожне відкриття головної кабінету
  // торгового. Частковий індекс нижче тут не рятує — його умова
  // (externalId + CONFIRMED) вужча за ці вибірки.
  //
  // docType у ключі: усі три місця, які цим ходять (debtDeltaByRep,
  // my-map, counterparties?mine=1), одразу відсівають повернення.
  @@index([counterpartyId, docType, createdAt(sort: Desc)])
}

model SalesDocumentItem {
  id              String @id @default(cuid())
  salesDocumentId String
  productId       String
  quantity        Int
  sellingPrice    Float
  purchasePrice   Float
  discountPercent Float  @default(0)

  salesDocument SalesDocument @relation(fields: [salesDocumentId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([salesDocumentId]) // позиції документа: json_agg у картці клієнта
  @@index([productId]) // зворотний обхід «товар -> хто брав» для рекомендацій
}

model Invoice {
  id              String         @id @default(cuid())
  number          String         @unique
  salesDocumentId String?        @unique
  counterpartyId  String
  status          DocumentStatus @default(DRAFT)
  paymentStatus   PaymentStatus  @default(UNPAID)
  totalAmount     Float
  paidAmount      Float          @default(0)
  dueDate         DateTime?
  notes           String?
  createdById     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  salesDocument SalesDocument? @relation(fields: [salesDocumentId], references: [id])
  counterparty  Counterparty   @relation(fields: [counterpartyId], references: [id])
  createdBy     User           @relation("invoiceCreator", fields: [createdById], references: [id])
  payments      Payment[]
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Float
  method    String   @default("bank_transfer")
  notes     String?
  createdAt DateTime @default(now())

  /// Дата оплати за даними джерела. createdAt — коли запис потрапив до
  /// нас, а paidAt — коли гроші реально прийшли. Для періодів мотивації
  /// має значення саме друге.
  paidAt DateTime?

  /// Ref_Key документа оплати в 1С — ідемпотентність синхронізації
  externalId String? @unique
  /// "1C" | "MANUAL" — звідки запис
  source     String  @default("MANUAL")

  /// Коли оплату востаннє підтвердило вивантаження 1С.
  ///
  /// Запит ПКО бере лише проведені документи, тож розпроведений у 1С ордер
  /// просто зникає з вікна — нулем чи ознакою скасування він не приходить.
  /// Без цієї мітки відрізнити його від оплати, що просто вийшла за межі
  /// вікна читання, неможливо. Див. reconcile-payments.ts.
  syncedAt DateTime?

  invoice     Invoice             @relation(fields: [invoiceId], references: [id])
  allocations PaymentAllocation[]

  @@index([paidAt])
  @@index([source, syncedAt])
}

model CommissionRate {
  id         String @id @default(cuid())
  salesRepId String
  brand      String
  percentage Float

  salesRep User @relation("commissionRates", fields: [salesRepId], references: [id])

  @@unique([salesRepId, brand])
}

model CommissionRecord {
  id               String           @id @default(cuid())
  salesRepId       String
  salesDocumentId  String
  brand            String
  saleAmount       Float
  costAmount       Float
  profitAmount     Float
  commissionRate   Float
  commissionAmount Float
  status           CommissionStatus @default(PENDING)
  paidAt           DateTime?
  createdAt        DateTime         @default(now())

  salesRep      User          @relation("commissionRecords", fields: [salesRepId], references: [id])
  salesDocument SalesDocument @relation(fields: [salesDocumentId], references: [id])
}

// ========== Stock Reservation ==========

model StockReservation {
  id              String   @id @default(cuid())
  productId       String
  salesDocumentId String
  quantity        Int
  createdAt       DateTime @default(now())

  product       Product       @relation(fields: [productId], references: [id])
  salesDocument SalesDocument @relation(fields: [salesDocumentId], references: [id], onDelete: Cascade)

  @@unique([productId, salesDocumentId])
}

// ========== Delivery / Logistics ==========

model DeliveryRoute {
  id              String              @id @default(cuid())
  number          String              @unique
  driverId        String?
  date            DateTime
  status          DeliveryRouteStatus @default(PLANNED)
  vehicleInfo     String?
  fuelConsumption Float? // л/100км або кВт·год/100км
  fuelPricePer    Float? // ціна за 1л або 1кВт·год
  totalDistanceKm Float?
  /// Фактичний пробіг, вводить адмін з паперового листа/одометра.
  /// null — зарплата рахується з планових км (totalDistanceKm, OSRM).
  /// У 1С кілометраж не живе (заповнені 2 листи з 40), тому джерело тут.
  actualKm        Float?
  totalFuelCost   Float?
  /// Геометрія обраного маршруту (GeoJSON LineString з OSRM). Зберігається
  /// при застосуванні порядку, щоб планшет малював лінію після
  /// перезавантаження, не смикаючи OSRM на кожне відкриття дня.
  routeGeometry   Json?
  notes           String?
  /// Коли маршрут передали водію. null — ще чернетка логіста.
  /// Разом зі статусом ASSIGNED це і є «передача»: до неї водій маршруту
  /// не бачить, і логіст може правити склад точок скільки завгодно.
  assignedAt      DateTime?
  assignedById    String?
  createdById     String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  driver     User?          @relation("driverRoutes", fields: [driverId], references: [id])
  createdBy  User           @relation("routeCreator", fields: [createdById], references: [id])
  assignedBy User?          @relation("routeAssigner", fields: [assignedById], references: [id])
  stops      DeliveryStop[]

  /// resolveDriverDay шукає саме так — водій + доба
  @@index([driverId, date])
}

model DeliveryStop {
  id              String             @id @default(cuid())
  deliveryRouteId String
  /// null — точка без накладної (бонусна поїздка: забрати товар, пошта).
  /// @unique лишається: у Postgres кілька NULL не конфліктують, тож одна
  /// накладна досі не може лежати у двох маршрутах.
  salesDocumentId String?            @unique
  counterpartyId  String?
  kind            DeliveryStopKind   @default(DELIVERY)
  /// Назва бонусної поїздки — те, що водій прочитає в чек-листі
  /// («Забрати ремонт», «Нова пошта, відділення 12»). Для DELIVERY порожнє:
  /// там ім'я дає контрагент.
  title           String?
  sequence        Int                @default(0)
  distanceKm      Float?
  deliveryCost    Float?
  status          DeliveryStopStatus @default(PENDING)
  address         String?
  /// Координати точки без контрагента. Для DELIVERY порожні: пін завжди
  /// береться з картки клієнта, щоб уточнення відбивалося на всіх маршрутах.
  lat             Float?
  lng             Float?
  /// Ручна оплата саме за цю точку, ₴. Перебиває тариф місто/область.
  /// Основне призначення — бонусні поїздки, для яких 25/15 ₴ не тариф.
  payOverride     Float?
  /// Зона саме цієї точки. Пріоритетніша за override на контрагенті:
  /// той самий клієнт сьогодні може бути в місті, а завтра на філії.
  zoneOverride    DeliveryZone?
  notes           String?
  deliveredAt     DateTime?
  createdAt       DateTime           @default(now())

  deliveryRoute DeliveryRoute  @relation(fields: [deliveryRouteId], references: [id], onDelete: Cascade)
  salesDocument SalesDocument? @relation(fields: [salesDocumentId], references: [id])
  counterparty  Counterparty?  @relation(fields: [counterpartyId], references: [id])

  @@index([deliveryRouteId, sequence])
}

// ========== Sales Rep Profile ==========

model SalesRepRegion {
  id         String @id @default(cuid())
  salesRepId String
  region     String // "Львів", "Радехів", "Вінницька область"

  salesRep User @relation(fields: [salesRepId], references: [id], onDelete: Cascade)

  @@unique([salesRepId, region])
}

model SalesRepClient {
  id             String @id @default(cuid())
  salesRepId     String
  counterpartyId String

  salesRep     User         @relation(fields: [salesRepId], references: [id], onDelete: Cascade)
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)

  @@unique([salesRepId, counterpartyId])
  // Питання «чий цей клієнт» ставиться частіше за «які клієнти в цього
  // торгового», а @@unique вище відповідає лише на друге: за порядком
  // колонок пошук за counterpartyId ним не скористається й іде Seq Scan-ом.
  @@index([counterpartyId])
}

model SalesRepCategoryAccess {
  id         String @id @default(cuid())
  salesRepId String
  categoryId String

  salesRep User     @relation(fields: [salesRepId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([salesRepId, categoryId])
}

// ========== Client Folders (Route Templates) ==========

model ClientFolder {
  id          String   @id @default(cuid())
  name        String // "Радехів", "Львів центр"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ClientFolderItem[]
}

model ClientFolderItem {
  id             String @id @default(cuid())
  folderId       String
  counterpartyId String

  folder       ClientFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)

  @@unique([folderId, counterpartyId])
}

// ========== Stock Locations (Warehouses) ==========

model StockLocation {
  id        String   @id @default(cuid())
  name      String // "Основний склад", "Магазин"
  address   String?
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  externalId String? @unique // Ref_Key складу в 1С

  // Сервісний склад: брак, уцінка, майстерня, ремонти. Товар там фізично є,
  // але продати його не можна, тому в Product.stock (вільний залишок) він не
  // входить. Без цієї позначки 43 позиції зі «Складу Браку» й «Майстерні»
  // висіли у вітрині як звичайний товар.
  isService Boolean @default(false)

  stocks LocationStock[]
}

model LocationStock {
  id              String @id @default(cuid())
  stockLocationId String
  productId       String
  quantity        Int    @default(0)

  // Резерв із 1С. quantity — фізичний залишок на складі; reserved — скільки з
  // нього вже обіцяно клієнтським замовленням. Торговий може продавати лише
  // available = quantity - reserved, а склад збирає з quantity. Одним числом
  // ці два сценарії не покрити: якщо віддати сайту лише фізичний залишок,
  // другий торговий продасть те, що вже зарезервував перший.
  reserved  Int @default(0)
  available Int @default(0)

  /// Коли пару «товар+склад» востаннє підтвердив зріз залишків 1С.
  ///
  /// Регістр віддає лише ненульові рядки, тож продана в нуль позиція просто
  /// зникає з вивантаження. На інкрементальних прогонах агент домальовує їй
  /// нуль сам (знає, що вона рухалась), але на повному прогоні такого списку
  /// немає — і без цієї мітки залишок лишався б ненульовим назавжди.
  syncedAt DateTime?

  stockLocation StockLocation @relation(fields: [stockLocationId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([stockLocationId, productId])
  @@index([syncedAt])
}

// ========== Saved Routes (Route Planner) ==========

model SavedRoute {
  id               String   @id @default(cuid())
  name             String
  startAddress     String
  startLat         Float
  startLng         Float
  vehicleType      String   @default("fuel") // "fuel" | "electric"
  consumption      Float    @default(10)
  pricePerUnit     Float    @default(56)
  totalDistanceKm  Float?
  totalDurationMin Float?
  totalFuelCost    Float?
  routeGeometry    Json? // GeoJSON LineString
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdBy User             @relation("savedRoutes", fields: [createdById], references: [id])
  stops     SavedRouteStop[]
}

model SavedRouteStop {
  id           String  @id @default(cuid())
  savedRouteId String
  address      String
  displayName  String?
  lat          Float
  lng          Float
  sequence     Int     @default(0)

  savedRoute SavedRoute @relation(fields: [savedRouteId], references: [id], onDelete: Cascade)
}

// ========== Sync (1С Integration) ==========

model SyncJob {
  id             String    @id @default(cuid())
  type           String // "products", "counterparties"
  status         String // "running", "completed", "failed"
  fileName       String
  recordsTotal   Int       @default(0)
  recordsCreated Int       @default(0)
  recordsUpdated Int       @default(0)
  recordsSkipped Int       @default(0)
  recordsFailed  Int       @default(0)
  errors         String? // JSON array of error messages
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  discrepancies SyncDiscrepancy[]
}

model SyncDiscrepancy {
  id          String   @id @default(cuid())
  syncJobId   String
  entityType  String // "product", "counterparty"
  entityRef   String // SKU або код контрагента
  entityName  String
  field       String // "price", "stock", "name", "NEW", "MISSING"
  value1C     String
  valueBudvik String
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  syncJob SyncJob @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  // 113 тис. рядків / 58 МБ, і до цієї міграції — жоден індекс, крім PK.
  // Закриття прогону робить три count по syncJobId поспіль, кожен був повним
  // скануванням 58 МБ. Шкода не стільки в самих count, скільки в тому, що
  // вони щоразу вимивали каталог із 128 МБ shared_buffers.
  @@index([syncJobId, field])
}

/// Реєстр застосованих батчів від агента 1С — забезпечує ідемпотентність:
/// повторна доставка того самого batchId не застосовується вдруге.
model SyncBatch {
  id         String   @id // batchId (uuid), який згенерував агент
  runId      String // збігається з SyncJob.fileName
  seq        Int
  entityType String
  records    Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([runId])
}

/// Ключ-значення для стану синхронізації: heartbeat агента, watermark'и,
/// час останньої повної звірки. Не містить даних предметної області.
model SyncState {
  key       String   @id // "agent:lastSeen", "products:lastFullRun", ...
  value     String
  updatedAt DateTime @updatedAt
}

// ========== Notifications ==========

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // "WHOLESALE_ORDER_REQUEST"
  title     String
  body      String
  isRead    Boolean  @default(false)
  relatedId String? // salesDocumentId
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ========== Звіти з складу (Telegram бот Budvik_Sklad) ==========
// УВАГА: ці моделі НЕ впливають на ERP. Розпізнані накладні зберігаються
// лише як звітність — SalesDocument / PurchaseOrder / LocationStock /
// Product.stock ніколи не змінюються з цього модуля.

model WarehouseShift {
  id     String               @id @default(cuid())
  userId String
  status WarehouseShiftStatus @default(OPEN)

  // Відкриття зміни
  openedAt        DateTime @default(now())
  openLat         Float?
  openLng         Float?
  openAddress     String? // reverseGeocode().shortName
  openAddressFull String? // reverseGeocode().displayName

  // Закриття зміни
  closedAt         DateTime?
  closeLat         Float?
  closeLng         Float?
  closeAddress     String?
  closeAddressFull String?

  durationMinutes Int? // рахується при закритті — для швидкої агрегації годин
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User              @relation("warehouseShiftWorker", fields: [userId], references: [id], onDelete: Cascade)
  reports WarehouseReport[]

  @@index([userId, openedAt])
  @@index([status])
}

model WarehouseReport {
  id      String                @id @default(cuid())
  userId  String
  shiftId String? // null, якщо фото надіслано поза зміною
  status  WarehouseReportStatus @default(PENDING)

  // Джерело (Telegram)
  telegramMessageId String?
  telegramFileId    String? @unique // ідемпотентність: одне фото = один звіт
  mediaGroupId      String? // Telegram album id
  batchId           String? // наш id пачки (= mediaGroupId або cuid)

  // Файл
  photoUrl      String
  photoKey      String // R2 key — щоб можна було видалити
  photoMimeType String?
  photoSize     Int?

  // Результат OCR (дзеркалить формат /api/erp/scan)
  docType               String? // "purchase" | "sales"
  docNumber             String?
  docDate               DateTime?
  counterpartyName      String?
  counterpartyCode      String?
  matchedCounterpartyId String?
  totalAmount           Float?
  itemsCount            Int       @default(0)
  notes                 String?
  rawResponse           Json? // повна відповідь Gemini для дебагу

  attempts     Int       @default(0)
  processedAt  DateTime?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User            @relation("warehouseReportWorker", fields: [userId], references: [id], onDelete: Cascade)
  shift               WarehouseShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  matchedCounterparty Counterparty?   @relation("warehouseReportCounterparty", fields: [matchedCounterpartyId], references: [id], onDelete: SetNull)

  items WarehouseReportItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([shiftId])
  @@index([mediaGroupId])
}

model WarehouseReportItem {
  id       String @id @default(cuid())
  reportId String

  name      String
  sku       String?
  quantity  Float   @default(0) // Float, не Int — накладні містять "12,5 м"
  price     Float   @default(0) // ціна за одиницю
  unit      String?
  lineTotal Float   @default(0) // quantity * price, денормалізовано для SUM

  // Фаззі-матчинг до Product — ЛИШЕ довідково, склад не змінюється
  matchedProductId    String?
  matchedProductName  String?
  matchedProductPrice Float?

  report         WarehouseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  matchedProduct Product?        @relation("warehouseItemProduct", fields: [matchedProductId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@index([matchedProductId])
  @@index([name])
}

/// Кому бот шле сповіщення про нове замовлення з сайту.
///
/// Окрема таблиця, а не прапорець на User: половині адресатів акаунт в адмінці
/// не потрібен — вони нічого там не роблять, лише мають першими побачити
/// замовлення. Людину ідентифікує telegramId; phone тут довідковий, бо бот
/// не вміє писати за номером, поки людина сама не натисне Start у боті.
model OrderAlertRecipient {
  id    String  @id @default(cuid())
  name  String
  phone String?

  /// Код підключення (6 цифр): людина відкриває t.me/<bot>?start=oa_<code>
  /// або диктує код боту. Лишається і після прив'язки — щоб переприв'язати
  /// людину після зміни телефона не заводячи новий рядок.
  code String @unique

  telegramId       String?   @unique
  telegramUsername String?
  linkedAt         DateTime?

  /// Вимкнений отримувач лишається в списку: людина у відпустці повернеться,
  /// а повторна прив'язка через бота була б зайвим колом. Сюди ж падає
  /// автовимкнення, коли Telegram відповів 403 (людина заблокувала бота).
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

/// Запит на прив'язку Telegram. Обслуговує ОБИДВІ ролі бота —
/// складовщика (WAREHOUSE) і торгового (SALES). Назва історична:
/// модель у проді, ренейм коштував би зайвої міграції.
model WarehouseLinkRequest {
  id               String    @id @default(cuid())
  telegramId       String
  telegramUsername String?
  telegramName     String? // first_name + last_name
  code             String    @unique // 6-значний код, який показує бот
  approved         Boolean   @default(false)
  approvedById     String?
  approvedAt       DateTime?
  linkedUserId     String?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())

  /// Роль, яку призначив адмін при підтвердженні. Бот її НЕ ставить:
  /// у момент /start він ще не знає, хто це, а самопризначення ролі
  /// зламало б сенс гейту requireWorker. Зберігаємо для аудиту —
  /// User.role потім можуть змінити.
  assignedRole Role?

  approvedBy User? @relation("warehouseLinkApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([telegramId])
  @@index([approved, expiresAt])
}

// ========== Поїздки торгових представників (той самий Telegram бот) ==========
// Свідомо окремі моделі, а не розширення WarehouseShift: у складовщика немає
// одометра, у торгового немає накладних — змішування залишило б половину
// колонок вічно порожніми. Як і склад, цей модуль НЕ впливає на ERP.

model SalesTrip {
  id     String          @id @default(cuid())
  userId String
  status SalesTripStatus @default(OPEN)

  // --- Старт ---
  startedAt        DateTime @default(now())
  startLat         Float?
  startLng         Float?
  startAddress     String? // reverseGeocode().shortName
  startAddressFull String?

  // Одометр Int, не Float: одометри цілочисельні в км, а Float спокушає
  // AI повертати 123456.7 з добового лічильника (TRIP), а не загального (ODO).
  startOdometer        Int? // null, поки фото не підтверджено — поїздка стартує від геолокації
  startOdometerSource  OdometerSource?
  startOdometerAiValue Int? // що сказав AI до правки — для оцінки якості моделі
  startPhotoUrl        String?
  startPhotoKey        String? // R2 key — щоб можна було видалити
  startPhotoMimeType   String?
  startTelegramFileId  String?         @unique // ідемпотентність: одне фото = один одометр
  startConfirmedAt     DateTime?

  // --- Фініш ---
  endedAt        DateTime? // ставиться при отриманні фінішної локації, ДО одометра
  endLat         Float?
  endLng         Float?
  endAddress     String?
  endAddressFull String?

  endOdometer        Int?
  endOdometerSource  OdometerSource?
  endOdometerAiValue Int?
  endPhotoUrl        String?
  endPhotoKey        String?
  endPhotoMimeType   String?
  endTelegramFileId  String?         @unique
  endConfirmedAt     DateTime?

  // --- Похідні: рахуємо один раз при закритті, щоб не агрегувати в JS ---
  distanceKm       Int? // endOdometer - startOdometer
  durationMinutes  Int?
  checkpointsCount Int  @default(0) // денормалізовано, інкрементується при створенні точки

  /// Різниця від'ємна, нульова або неправдоподібна. Поїздку все одно
  /// зберігаємо — рішення за людиною, не за ботом.
  odometerSuspicious Boolean @default(false)
  notes              String?

  // ---- Контроль пробігу ----
  // Одометр каже, СКІЛЬКИ проїхано, але не каже КУДИ. Торговий може
  // накрутити кілометри цілком реальною поїздкою у своїх справах —
  // фото буде чесне, AI прочитає правильно. Ловить це лише зіставлення
  // з геолокацією.

  /// Відстань по GPS-точках (старт → чекпоінти → фініш), по прямій, км.
  /// Це НИЖНЯ межа: реальна дорога завжди довша за пряму.
  gpsDistanceKm Int?

  /// Відношення одометра до GPS-відстані. ~1.2-1.6 — норма (дороги не
  /// прямі). Значно більше — або мало чекпоінтів, або зайві кілометри.
  /// Рахуємо лише коли точок достатньо, щоб маршрут був осмислений.
  odometerToGpsRatio Float?

  /// Пробіг між кінцем попередньої поїздки і початком цієї.
  /// НЕ порушення: торговий може їздити на авто у своїх справах, просто
  /// паливо за свій кошт. Рахуємо для обліку, а не для тривоги.
  personalKm Int?

  /// Фото не щойно з камери: переслане, з галереї або старіше за поїздку.
  /// Найдешевший спосіб надіслати вчорашній одометр — саме такий.
  startPhotoSuspicious Boolean @default(false)
  endPhotoSuspicious   Boolean @default(false)

  // ---- Фонова трансляція геолокації (Telegram live location) ----
  // Чекпоінти ставить людина, тож їх може не бути зовсім: обдзвонив
  // клієнтів по телефону, а кнопку не натиснув — і маршрут порожній.
  // Трек іде сам, без участі торгового, і саме він показує, ДЕ той був.

  /// message_id повідомлення з живою локацією. Оновлення приходять
  /// як edited_message з тим самим id — інакше їх не зіставити з поїздкою.
  liveMessageId Int?

  /// Чат, у якому триває трансляція: нагадування про згасання шлемо саме туди.
  liveChatId String?

  /// Коли трансляція почалася і коли Telegram її обірве (live_period).
  liveStartedAt DateTime?
  liveExpiresAt DateTime?

  /// Остання точка треку — щоб не тягнути таблицю заради «чи живий трек».
  liveLastPointAt DateTime?

  /// Трансляцію вимкнули руками посеред дня. Не порушення саме по собі
  /// (сів акумулятор, iOS прибив фон), але привід подивитися.
  liveStoppedAt DateTime?

  /// Довжина треку по точках, км. На відміну від gpsDistanceKm рахується
  /// не по чекпоінтах, а по фоновим точкам — торговий на неї не впливає.
  trackDistanceKm Int?

  /// Скільки хвилин трансляція реально працювала протягом поїздки.
  /// Мала цифра при довгій поїздці = день практично без контролю.
  trackMinutes Int?

  /// Частка поїздки, покрита треком (0..1). Головна метрика дисципліни:
  /// саме її має сенс вішати на премію, а не сам факт увімкнення.
  trackCoverage Float?

  // ---- Відхилення від призначеного маршруту ----
  // Рахується один раз при закритті поїздки: трек уже не зміниться, а
  // перераховувати це на кожному відкритті звіту — зайва робота на
  // сотнях тисяч точок.

  /// Шаблон маршруту, з яким порівнювали (RouteTemplate.id на той день).
  /// Зберігаємо саме id, а не назву: призначення завтра можуть змінити,
  /// і тоді вчорашній висновок стосувався б іншого маршруту.
  routeTemplateId String?

  /// Частка точок треку в межах коридору маршруту (0..1).
  onRouteRatio Float?

  /// Кілометри, намотані поза коридором. Це не «порушення», а сума
  /// непояснених планом кілометрів — привід подивитися.
  offRouteKm Int?

  /// Значущі епізоди виїзду за коридор: [{from,to,minutes,km,lat,lng}].
  /// JSON, а не окрема таблиця: епізодів одиниці, читаються лише разом
  /// із поїздкою, і жодних запитів «усі епізоди за місяць» не буде.
  excursions Json?

  /// Алерт уже надіслано — щоб повторний перерахунок не слав його вдруге.
  deviationAlertedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User              @relation("salesTripRep", fields: [userId], references: [id], onDelete: Cascade)
  checkpoints SalesCheckpoint[]
  trackPoints SalesTrackPoint[]

  @@index([userId, startedAt])
  @@index([status])
  @@index([startedAt])
}

/// Відмітка у клієнта. Необов'язкова, повторювана, лише геолокація + час.
/// Фото і одометра тут свідомо немає — це «я тут», а не звіт.
model SalesCheckpoint {
  id     String @id @default(cuid())
  tripId String
  userId String // денормалізовано: аналітика по торговому без join через trip

  lat         Float
  lng         Float
  address     String?
  addressFull String?

  /// Порядковий номер у межах поїздки, 1-based.
  seq Int

  /// Хвилини від попередньої точки (від старту поїздки для seq=1).
  /// Рахуємо при вставці — інакше кожен звіт робив би віконну функцію.
  minutesFromPrev Int?

  /// Метри від попередньої точки по прямій. Не одометр — грубий контроль
  /// «чи торговий узагалі рухався між клієнтами».
  metersFromPrev Int?

  clientNote String? // на майбутнє: назва клієнта / коментар

  createdAt DateTime @default(now())

  trip SalesTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User      @relation("salesCheckpointRep", fields: [userId], references: [id], onDelete: Cascade)

  // Ловить гонку подвійного тапу на рівні БД — бот трактує P2002 як дубль
  @@unique([tripId, seq])
  @@index([tripId, createdAt])
  @@index([userId, createdAt])
}

/// Точка фонового треку з живої локації Telegram.
///
/// Відрізняється від SalesCheckpoint принципово: чекпоінт ставить людина
/// («я у клієнта»), а точку треку — телефон, сам, без жодної дії. Тому
/// чекпоінти показують, де торговий СКАЗАВ, що був, а трек — де він був
/// насправді. Саме розбіжність між ними і є предметом контролю.
///
/// Рядків багато (день ≈ 100–200 точок на людину), тому модель свідомо
/// вузька: жодних адрес і зворотного геокодування при вставці.
model SalesTrackPoint {
  id     String @id @default(cuid())
  tripId String
  userId String // денормалізовано: добірка треку по торговому без join

  lat Float
  lng Float

  /// Радіус похибки GPS у метрах (horizontal_accuracy з Bot API).
  /// Точка з похибкою 500 м не доводить нічого — без цього поля
  /// «був за 300 м від клієнта» неможливо інтерпретувати.
  accuracyM Int?

  /// Курс і швидкість, якщо телефон їх дав. Швидкість тут — миттєва,
  /// з GPS, а не порахована нами: вона відрізняє «стоїть у клієнта»
  /// від «проїжджає повз».
  headingDeg Int?
  speedKmh   Int?

  /// Час події за Telegram (edit_date), а не час запису в БД: воркер
  /// міг лежати, і тоді createdAt збрехав би про момент перебування.
  recordedAt DateTime

  /// Метри й хвилини від попередньої точки треку. Рахуємо при вставці,
  /// щоб звіти не робили віконних функцій по сотнях тисяч рядків.
  metersFromPrev  Int?
  minutesFromPrev Int?

  createdAt DateTime @default(now())

  trip SalesTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User      @relation("salesTrackRep", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId, recordedAt])
  @@index([userId, recordedAt])
}

// ========== Бренди, плани та мотивація торгових ==========
// Наріжне рішення: комісія нараховується від ЗІБРАНИХ ГРОШЕЙ, а не від
// обороту. Продав клієнту, який не заплатив, — не заробив. Дебіторка з
// покарання перетворюється на мотивацію: забери гроші й отримай своє.

/// Довідник брендів. Заводить адмін руками — номенклатура з 1С не має
/// окремого поля бренду, а евристика «перше слово назви» ненадійна.
model Brand {
  id       String  @id @default(cuid())
  name     String  @unique // «SomaFix», «Ataman», «Polax», «Liger»
  slug     String  @unique
  isActive Boolean @default(true)
  /// Порядок у списках і на дашборді торгового
  priority Int     @default(0)
  /// Колір для кружків прогресу (#RRGGBB)
  color    String?

  /// Логотип бренда — повна адреса або шлях від кореня сайту.
  ///
  /// Порожньо в переважної більшості, і це нормально: у каталозі 359 брендів,
  /// а справжніх логотипів у нас п'ять. Малювати решту «схожими» не можна —
  /// це чужі торгові марки, і приблизний логотип гірший за його відсутність.
  /// Там, де порожньо, застосунок малює плитку з назвою на фірмовому кольорі.
  logoUrl String?

  /// Підказки для автопривʼязки товарів: якщо назва товару містить
  /// будь-який із цих рядків — вважаємо, що це бренд. Зберігаємо
  /// правило, а не результат, щоб можна було переприв'язати після
  /// чергового імпорту номенклатури.
  matchPatterns String[] @default([])

  externalId String? @unique // Ref_Key з 1С, якщо бренд там ведеться

  /// Коефіцієнт «роздріб = опт × k» для товарів, у яких в 1С немає
  /// роздрібної ціни (TOTAL, POLAX заведені лише як «4.ОПТ»). null —
  /// загальний DEFAULT_RETAIL_MARKUP (src/lib/pricing/retail-markup.ts).
  retailMarkup Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  plans    SalesPlan[]
  rules    MotivationRule[]

  @@index([isActive, priority])
}

/// План. Одна модель на всі рівні: конкретний торговий або вся команда
/// (repId = null), конкретний бренд або загальний (brandId = null).
model SalesPlan {
  id          String     @id @default(cuid())
  period      PlanPeriod
  metric      PlanMetric @default(COLLECTED_AMOUNT)
  /// Початок періоду за київським часом. Кінець виводиться з period —
  /// зберігати обидві межі означало б ризик їх розсинхронізації.
  periodStart DateTime

  /// null — план на всю команду; інакше персональний
  repId   String?
  /// null — загальний план; інакше по конкретному бренду
  brandId String?

  targetValue Float
  notes       String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rep       User?  @relation("salesPlanRep", fields: [repId], references: [id], onDelete: Cascade)
  brand     Brand? @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy User   @relation("salesPlanAuthor", fields: [createdById], references: [id])

  // Один план на комбінацію: період + метрика + дата + торговий + бренд
  @@unique([period, metric, periodStart, repId, brandId])
  @@index([periodStart, period])
  @@index([repId, periodStart])
}

/// Схема мотивації — набір правил. Торговий може бути на одній схемі,
/// а команда новачків на іншій, без правок коду.
model MotivationScheme {
  id          String  @id @default(cuid())
  name        String
  description String?
  isActive    Boolean @default(true)
  /// Схема за замовчуванням для торгових без явного призначення
  isDefault   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rules       MotivationRule[]
  assignments MotivationAssignment[]

  @@index([isActive])
}

/// Правило нарахування. Кілька правил однієї схеми сумуються.
model MotivationRule {
  id        String             @id @default(cuid())
  schemeId  String
  type      MotivationRuleType
  /// Порядок застосування; утримання зазвичай ідуть останніми
  sortOrder Int                @default(0)
  isActive  Boolean            @default(true)

  /// Обмеження дії правила. null = діє на все.
  brandId       String? // лише по цьому бренду
  categoryGroup String? // ключ із categoryGroups.ts

  /// Основне значення: відсоток для PERCENT_*, сума для PLAN_BONUS_FIXED
  value Float @default(0)

  /// Для PLAN_BONUS_* і TIERED_PERCENT — з якого % виконання плану діє
  planMetric    PlanMetric? // яку метрику перевіряти
  thresholdFrom Float? // напр. 100 — від 100% виконання
  thresholdTo   Float? // напр. 120 — до 120%

  /// Для OVERDUE_PENALTY: утримувати value% за кожен відсоток
  /// простроченої дебіторки понад цей поріг
  overdueTolerance Float?

  notes String?

  scheme MotivationScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  brand  Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@index([schemeId, sortOrder])
}

/// Хто на якій схемі і з якого моменту. Історія зберігається — інакше
/// перерахунок минулого місяця дав би нові цифри.
model MotivationAssignment {
  id        String    @id @default(cuid())
  repId     String
  schemeId  String
  validFrom DateTime  @default(now())
  validTo   DateTime?

  rep    User             @relation("motivationRep", fields: [repId], references: [id], onDelete: Cascade)
  scheme MotivationScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@index([repId, validFrom])
}

/// ========== Розрахунок мотивації по валу ==========
/// Дзеркало таблиці «Мотивація Торговий Відділ»: вал по валютах з 1С-звіту
/// «Валовая прибыль вал», курси місяця, сходинки бонусу за виконання плану
/// і «фірми за дужками» з індивідуальними умовами.
///
/// Вал зараз вноситься вручну (обмін з 1С собівартість не передає — див.
/// apply-documents.ts). Коли обмін навчиться передавати собівартість і
/// валюту закупівлі, ці ж поля заповнюватимуться автоматично.

/// Місяць розрахунку: курси валют і сходинки бонусу. Курси фіксуються на
/// місяць (як «Курс валют на вересень» у таблиці), а не тягнуться з НБУ:
/// зарплата не має стрибати від того, що курс змінився після нарахування.
model MotivationPayrollMonth {
  id    String   @id @default(cuid())
  /// Перше число місяця — так само, як periodStart у SalesPlan
  month DateTime @unique

  usdRate Float @default(0)
  eurRate Float @default(0)
  plnRate Float @default(0)

  /// Сходинки «% виконання плану → % від валу»:
  /// { "steps": [{ "limit": 100, "percent": 30 }, { "limit": 120, "percent": 35 }], "topPercent": 40 }
  /// Читається: < 100% → 30, 100–120% → 35, > 120% → 40.
  tiers Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries     MotivationPayrollEntry[]
  termEntries IndividualTermsEntry[]
}

/// Рядок таблиці: показники одного торгового за місяць.
/// Розрахункові колонки (K, застосований %, бонуси) не зберігаються —
/// вони чиста функція від цих полів і налаштувань місяця (payroll.ts).
model MotivationPayrollEntry {
  id      String @id @default(cuid())
  monthId String
  repId   String

  workDays      Int   @default(0)
  /// План і факт (грн) фіксуються в рядку, а не читаються з SalesPlan:
  /// план могли змінити заднім числом, а зарплата має лишитись як була
  planAmount    Float @default(0)
  factAmount    Float @default(0)
  /// Вал по валютах закупівлі, без ПДВ і без груп з індивідуальними умовами
  grossUah      Float @default(0)
  grossUsd      Float @default(0)
  grossEur      Float @default(0)
  grossPln      Float @default(0)
  /// Бонуси, віддані клієнтам — віднімаються від загального валу
  clientBonuses Float @default(0)

  month MotivationPayrollMonth @relation(fields: [monthId], references: [id], onDelete: Cascade)
  rep   User                   @relation("payrollEntries", fields: [repId], references: [id], onDelete: Cascade)

  @@unique([monthId, repId])
}

/// «Фірми за дужками»: група брендів з індивідуальними умовами співпраці
/// (APRO + Сила + UNIFIX + 12Atelie). Їхній вал не входить у загальний
/// котел — бонус рахується окремо від продажів групи.
model IndividualTermsGroup {
  id        String  @id @default(cuid())
  name      String
  /// Довідково: перелік брендів групи текстом, як у групі 1С
  brands    String  @default("")
  /// Валюта, в якій вносяться продажі групи: UAH | USD | EUR | PLN
  currency  String  @default("USD")
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  entries IndividualTermsEntry[]
}

/// Продажі торгового по групі за місяць. Відсоток бонусу — РУЧНИЙ:
/// торговий сам вирішує, де прогнутись по ціні заради обороту, а де
/// продати з більшою рентабельністю, тож фіксованої шкали немає —
/// адмін ставить відсоток, дивлячись на коефіцієнт рентабельності.
model IndividualTermsEntry {
  id      String @id @default(cuid())
  monthId String
  groupId String
  repId   String

  /// Продажі групи за місяць у валюті групи, без ПДВ
  salesAmount  Float  @default(0)
  /// Коеф. рентабельності з 1С — довідковий, на формулу не впливає
  rentCoef     Float?
  /// % для бонусу: бонус = продажі × % × курс валюти групи
  bonusPercent Float  @default(0)

  month MotivationPayrollMonth @relation(fields: [monthId], references: [id], onDelete: Cascade)
  group IndividualTermsGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  rep   User                   @relation("individualTermsEntries", fields: [repId], references: [id], onDelete: Cascade)

  @@unique([monthId, groupId, repId])
  @@index([monthId, repId])
}

/// Рознесення оплати на торгового. Payment сам по собі не знає, хто
/// продав: Invoice.salesDocumentId опціональний і часто порожній.
/// Ця таблиця — місток «гроші → торговий», без якого «скільки реально
/// забрали» порахувати неможливо.
model PaymentAllocation {
  id        String @id @default(cuid())
  paymentId String
  repId     String

  /// Частина платежу, віднесена на цього торгового
  amount       Float
  /// Прибуток у цій частині: рахується пропорційно маржі накладної,
  /// бо оплата може бути частковою
  profitAmount Float   @default(0)
  /// Бренд, якщо оплату вдалося рознести по позиціях накладної
  brandId      String?

  /// Як визначили торгового: DOCUMENT (через SalesDocument),
  /// CLIENT (через закріплення SalesRepClient), MANUAL (адмін вказав)
  source String @default("DOCUMENT")

  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  rep     User    @relation("paymentAllocations", fields: [repId], references: [id], onDelete: Cascade)

  @@index([repId, createdAt])
  @@index([paymentId])
}

/// Шаблон маршруту: іменований набір населених пунктів («Радехівський
/// напрямок»). Окремо від SavedRoute, бо той будується від складу під
/// конкретну доставку, а цей — сталий напрямок торгового на день тижня.
model RouteTemplate {
  id       String  @id @default(cuid())
  name     String
  /// Колір полілінії на мапі (#RRGGBB)
  color    String?
  isActive Boolean @default(true)

  /// Область для геокодування («Львівська»). Без неї Nominatim знаходить
  /// однойменні села в інших областях: «Лопатин» — у Вінницькій,
  /// «Витків» — у Рівненській, і маршрут виходить у 5 разів довший.
  region String?

  /// GeoJSON LineString від OSRM. Кешується при створенні/зміні стопів:
  /// інакше кожен перегляд мапи смикав би зовнішній сервіс.
  routeGeometry   Json?
  totalDistanceKm Float?

  /// Межа зони, виправлена адміном руками: масив кілець [[{lat,lng}...]].
  /// Поки null — зона рахується автоматично як коридор радіуса zoneRadiusKm
  /// навколо маршруту. Щойно адмін посунув хоч одну точку, істиною стає це
  /// поле: автоматика знає лише відстань до дороги, а людина — що за річкою
  /// мосту немає і туди півтори години.
  zonePolygon  Json?
  /// Радіус коридору (км), з яким зона рахується автоматично. Зберігається,
  /// щоб торговий бачив ту саму зону, яку налаштував керівник, а не типові 10.
  zoneRadiusKm Float?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User                @relation("routeTemplateAuthor", fields: [createdById], references: [id])
  stops       RouteTemplateStop[]
  assignments RouteAssignment[]

  @@index([isActive])
}

/// Зупинка шаблону. settlement — те, що ввів адмін («Радехів»),
/// displayName — що знайшов Nominatim: видно, чи влучило геокодування.
model RouteTemplateStop {
  id          String  @id @default(cuid())
  templateId  String
  settlement  String
  displayName String?
  lat         Float
  lng         Float
  seq         Int     @default(0)

  template RouteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, seq])
}

/// Призначення маршруту торговому: АБО на конкретну дату (разове),
/// АБО на день тижня (повторюване). Дата має пріоритет над weekday —
/// так разова заміна не ламає постійний розклад.
model RouteAssignment {
  id         String @id @default(cuid())
  repId      String
  templateId String

  /// Початок київської доби; null — це weekday-правило
  date    DateTime?
  /// 1..7 (ISO: 1 = понеділок); null — це разове призначення
  weekday Int?

  createdAt DateTime @default(now())

  rep      User          @relation("routeAssignmentRep", fields: [repId], references: [id], onDelete: Cascade)
  template RouteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  // Postgres NULLS DISTINCT: weekday-рядки не заважають date-рядкам і навпаки.
  // XOR date/weekday перевіряється в API — Prisma такого констрейнта не виражає.
  @@unique([repId, date])
  @@unique([repId, weekday])
  @@index([date])
}

/// Авто торгового для розрахунку палива. Окрема таблиця, а не поля на
/// User: ціна пального різна (дизель/газ/бензин), тож зберігається
/// разом з нормою, а не глобально.
model SalesVehicle {
  id    String  @id @default(cuid())
  repId String  @unique
  label String? // «Renault Kangoo AC1234BC»

  /// л/100 км
  fuelConsumption Float @default(10)
  /// грн за літр
  fuelPricePerL   Float @default(56)

  /// Звідки торговий виїжджає вранці: дім, склад — те, що для нього база.
  ///
  /// Без цього поля план і факт міряли різні речі. Маршрут «Стрий» — це
  /// 246 км МІЖ ПУНКТАМИ, а торговий живе не в першому пункті: у пробіг
  /// іде ще дорога туди і назад, і в кожного вона своя. Порівнювати факт
  /// із голим маршрутом означало б вимагати від людини, що живе за 40 км,
  /// тих самих кілометрів, що й від сусіда першого пункту.
  ///
  /// Адреса зберігається разом із координатами: перша — щоб адмін бачив,
  /// що саме він увів, друга — щоб не смикати геокодер на кожен перегляд.
  baseAddress String?
  baseLat     Float?
  baseLng     Float?

  /// Кеш подачі: км від бази до першого пункту й від останнього назад,
  /// окремо для кожного шаблону маршруту — {"templateId": km}.
  ///
  /// Рахується OSRM при зміні бази або маршруту, а не на кожен перегляд:
  /// публічний демо-сервер OSRM лімітує запити, і перегляд списку з двох
  /// сотень змін клав би його щоразу. Порожнє поле означає «ще не
  /// рахували», а не «нуль кілометрів» — панель ці випадки розрізняє.
  baseLegsKm Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rep User @relation("salesVehicle", fields: [repId], references: [id], onDelete: Cascade)
}

/// Знімок дебіторки клієнта на кінець дня.
///
/// 1С віддає лише поточне сальдо, і без історії неможливо сказати, чи
/// борг за місяць виріс, чи торговий його закрив. А саме на прирості
/// рахується зарплата: відвантажив на 100 тис., борг клієнтів виріс на
/// 30 — реально приніс 70.
///
/// Один рядок на клієнта на добу: частіші знімки нічого не додають, бо
/// обмін із 1С відбувається раз на день.
model DebtSnapshot {
  id             String   @id @default(cuid())
  counterpartyId String
  /// Київська дата, на кінець якої зафіксовано сальдо
  day            DateTime
  balance        Float

  /// Розбивка за строками на цю дату, якщо 1С її давала
  current       Float?
  overdue30     Float?
  overdue60     Float?
  overdue90     Float?
  overdue90Plus Float?

  createdAt DateTime @default(now())

  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)

  @@unique([counterpartyId, day])
  @@index([day])
}

/// Кеш АІ-інсайтів по торговому або по команді.
///
/// Інсайти генеруються за кнопкою, а не автоматично, і коштують токенів,
/// тож перегенерувати їх на кожен перехід між вкладками не можна. Ключ —
/// (вид, торговий, межі періоду): той самий період має віддавати той
/// самий висновок, поки керівник свідомо не натисне «оновити».
///
/// `facts` зберігається поруч із `insights` навмисно: картка показує
/// числа з нашого зведення, а не зі слів моделі, і без збереженого
/// зведення довелося б перераховувати весь SQL заради відображення кешу.
model AiInsightReport {
  id String @id @default(cuid())

  /// "rep" — по одному торговому, "team" — по команді
  kind    String
  /// null для командного звіту
  repId   String?
  fromDay String
  toDay   String

  /// Масив Insight (див. src/lib/ai/insights.ts)
  insights Json
  /// Зведення, на якому згенеровано — джерело чисел для карток
  facts    Json

  /// Яка модель відповідала — щоб було видно, чим саме згенеровано старий звіт
  model     String
  tokens    Int      @default(0)
  createdAt DateTime @default(now())

  rep User? @relation("aiInsightRep", fields: [repId], references: [id], onDelete: Cascade)

  @@unique([kind, repId, fromDay, toDay])
  @@index([createdAt])
}

/// Збережений АІ-звіт — архів, який керівник відклав навмисно.
///
/// Окрема модель, а не прапорець на AiInsightReport, бо в них різне життя.
/// Кеш — це «останній звіт за цей період», його щоразу перезаписує наступна
/// генерація, і ключ у нього (вид, торговий, період). Архів — знімок на
/// момент збереження: той самий період можна відкласти двічі з різницею в
/// місяць і потім порівняти, що змінилося. Прапорцем таке не виражається.
///
/// insights і facts копіюються значеннями, а не посиланням на кеш: сенс
/// архіву в тому, що він не змінюється, коли цифри в базі поїхали далі.
model SavedAiReport {
  id String @id @default(cuid())

  /// "rep" — по одному торговому, "team" — по команді
  kind    String
  /// null для командного звіту
  repId   String?
  fromDay String
  toDay   String

  /// Назва від керівника; якщо не ввів — складається з виду й періоду
  title String
  /// Нащо відклали: «перед розмовою з Дмитром», «база для порівняння»
  note  String?

  /// Копії на момент збереження (див. src/lib/ai/insights.ts)
  insights Json
  facts    Json

  model  String
  tokens Int    @default(0)

  /// Хто відклав — у списку архіву видно автора
  savedById String
  createdAt DateTime @default(now())

  rep     User? @relation("savedAiReportRep", fields: [repId], references: [id], onDelete: Cascade)
  savedBy User  @relation("savedAiReportAuthor", fields: [savedById], references: [id])

  @@index([kind, repId, createdAt])
  @@index([createdAt])
}

/// Маршрутний лист з 1С — факт виїзду водія за день.
///
/// Окрема модель, а не розширення DeliveryRoute: той є планувальною
/// сутністю сайту (адмін малює маршрут, createdById обов'язковий,
/// DeliveryStop.salesDocumentId @unique). Маршрутний лист — обліковий
/// документ 1С, який приходить готовим і жодного автора на сайті не має.
/// Той самий поділ, що SalesDocument (1С) ≠ Order (сайт).
///
/// На цьому документі рахується зарплата водія: ставка за пробіг (за КОЖЕН
/// лист, не за день), надбавка за кожну унікальну точку вигрузки і відсоток
/// від (ordersTotal − debtsTotal). Див. src/lib/drivers/payroll.ts.
model RouteSheet {
  id         String   @id @default(cuid())
  externalId String   @unique // Ref_Key з 1С — єдиний ключ ідемпотентності
  number     String
  /// Дата документа = робочий день водія
  date       DateTime
  posted     Boolean  @default(true)

  /// Як водія записано в 1С — і для діагностики, і для списку нерозмаплених
  driverName1C       String?
  /// Ref_Key водія в 1С; стабільніший за ім'я, зіставляється з User.driver1CExternalId
  driverExternalId1C String?
  /// null — водія ще не прив'язали до акаунта; лист зберігається все одно
  driverId           String?

  vehicle    String?
  distanceKm Float   @default(0)

  /// Сума замовлень, які водій везе цим листом (з 1С)
  ordersTotal Float @default(0)
  /// Сума боргів за попередні доставки, які він забирає (з 1С).
  /// База відсотка = ordersTotal − debtsTotal.
  debtsTotal  Float @default(0)

  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver User?            @relation("driverRouteSheets", fields: [driverId], references: [id])
  stops  RouteSheetStop[]

  @@index([driverId, date])
  @@index([date])
  @@index([driverExternalId1C])
}

/// Рядок маршрутного листа — одна точка вигрузки.
///
/// salesDocumentId НЕ @unique (на відміну від DeliveryStop): те саме
/// замовлення може потрапити і в плановий маршрут сайту, і в маршрутний
/// лист 1С, а унікальність зламала б прийом.
///
/// Точки для оплати рахуються за УНІКАЛЬНОЮ адресою в межах листа: три
/// рядки з однією адресою — одна точка. Дедуплікація живе в
/// src/lib/drivers/payroll-facts.ts, а не тут, щоб зміна правила не
/// вимагала переливання даних.
model RouteSheetStop {
  id           String @id @default(cuid())
  routeSheetId String
  sequence     Int    @default(0)

  counterpartyId  String?
  salesDocumentId String?
  /// Адреса з 1С, якщо документ її несе; інакше беремо з контрагента
  address         String?

  amount     Float @default(0)
  debtAmount Float @default(0)

  /// Точку додав адмін на сайті, а не обмін. Такі рядки прийом не чіпає:
  /// у 1С їх немає, і переливання точок їх би щоразу стирало.
  manual Boolean @default(false)

  /// Точку прибрали руками. Не видаляємо: наступний обмін привіз би її
  /// назад (реалізація в 1С нікуди не ділася), і «прибрана» точка щодня
  /// відроджувалася б. Прихована точка не показується і не оплачується.
  hidden Boolean @default(false)

  routeSheet    RouteSheet     @relation(fields: [routeSheetId], references: [id], onDelete: Cascade)
  counterparty  Counterparty?  @relation(fields: [counterpartyId], references: [id])
  salesDocument SalesDocument? @relation("routeSheetStops", fields: [salesDocumentId], references: [id])

  @@index([routeSheetId])
  @@index([counterpartyId])
}

/// Ручна надбавка водію: доставка Новою поштою, підміна, утримання.
///
/// Те, чого немає в 1С і що не виводиться з маршрутного листа. Сума може
/// бути від'ємною — це утримання; причина обов'язкова, бо саме вона
/// пояснює рядок у розрахунковому листку.
model DriverBonus {
  id       String   @id @default(cuid())
  driverId String
  /// Київська дата, до якої належить надбавка
  date     DateTime
  amount   Float
  reason   String

  createdById String
  createdAt   DateTime @default(now())

  driver    User @relation("driverBonusDriver", fields: [driverId], references: [id], onDelete: Cascade)
  createdBy User @relation("driverBonusAuthor", fields: [createdById], references: [id])

  @@index([driverId, date])
  @@index([date])
}

/// Ставки зарплати водіїв — один рядок на всю систему.
///
/// Таблиця, а не константи в коді: ставки міняє адмін без розробника.
/// Історії немає навмисно — зміна ставки перераховує і минулі періоди.
/// Якщо знадобиться фіксувати минуле, додається validFrom, і модель стає
/// журналом; поки що зайва складність.
model DriverPayrollRates {
  id String @id @default("default")

  /// Ставка за маршрутний лист залежно від пробігу:
  /// < kmTier1Max → kmTier1Rate; kmTier1Max..kmTier2Max → kmTier2Rate; далі kmTier3Rate.
  /// Межі включно в середній тір: 100 км → 700, 300 км → 700.
  kmTier1Max  Float @default(100)
  kmTier1Rate Float @default(500)
  kmTier2Max  Float @default(300)
  kmTier2Rate Float @default(700)
  kmTier3Rate Float @default(1000)

  /// За кожну унікальну точку вигрузки
  cityPointRate   Float @default(25)
  oblastPointRate Float @default(15)

  /// Відсоток від (ordersTotal − debtsTotal), у відсотках: 0.5 = 0,5%
  turnoverPercent Float @default(0.5)

  updatedAt DateTime @default(now()) @updatedAt
}

// ========== Карта клієнтів ==========

/// Звідки взялися координати клієнта на карті.
///
/// FAILED зберігається навмисно: без нього кожен запуск бекфілу знову
/// витрачав би 6-8 запитів до Nominatim на ту саму безнадійну адресу.
enum GeoSource {
  GEOCODED
  MANUAL
  /// Геокодер знайшов лише населений пункт, не адресу. Такий пін гірший
  /// за відсутність піна: виглядає точним, а каже лише «десь у цьому
  /// місті». Карта показує їх напівпрозорими й окремим фільтром, щоб
  /// їх не плутали зі справжніми точками.
  CITY
  FAILED
}

enum ProspectStatus {
  NEW
  IN_PROGRESS
  CONVERTED
  REJECTED
}

/// Точка для розпрацювання: магазин, якого ще немає в клієнтах.
///
/// Навмисно окрема таблиця, а не рядок у Counterparty: контрагенти —
/// власність 1С (externalId, синхронізація), і намальована на карті
/// «майбутня» точка засмічувала б усі списки ERP та могла зіткнутися
/// з реальним контрагентом при обміні. Коли клієнта відкрили,
/// counterpartyId зв'язує точку з реальним контрагентом.
model ProspectClient {
  id      String  @id @default(cuid())
  name    String
  address String?
  lat     Float
  lng     Float
  notes   String?

  status ProspectStatus @default(NEW)

  /// Кому доручено розпрацювати
  assignedRepId String?
  createdById   String?

  /// Заповнюється при конверсії в реального клієнта
  counterpartyId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedRep  User?         @relation("prospectAssignedRep", fields: [assignedRepId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("prospectAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  counterparty Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([assignedRepId])
}

/// Коментар торгового про клієнта: домовленості, особливості роботи, чого чекати.
///
/// Живе окремо від Counterparty.notes, бо той — одне поле на всіх і його
/// перезаписує будь-хто. Тут стрічка з автором і датою: видно, хто що
/// казав і коли, а торговий на маршруті бачить контекст перед візитом.
model ClientComment {
  id             String @id @default(cuid())
  counterpartyId String
  authorId       String

  /// Порожній рядок дозволено: запис може бути самим лише фото локації.
  text String

  /// Фото локації: як виглядає вхід, з якого боку заїзд, де розвантажувати.
  /// Живе в тій самій стрічці, що й текст, бо це той самий вид знання —
  /// «що треба знати, під'їжджаючи сюди», і водій має бачити їх разом.
  photoUrl String?
  photoKey String? // ключ у R2 — щоб можна було видалити разом із записом

  /// Де стояв телефон у мить зйомки. Не координати клієнта (для них є
  /// Counterparty.deliveryLat) — саме місце зйомки: за ним видно, звідки
  /// знято під'їзд, і чи автор справді був на місці.
  lat Float?
  lng Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  author       User         @relation("clientCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  /// Картка клієнта читає свіжі згори.
  @@index([counterpartyId, createdAt])
}

// ========== Планшет у машині: живий трек і чек-ліст візитів ==========
// Планшет закріплений у машині, завжди на зарядці, вкладка з картою на
// передньому плані. Тому трек збирає САМ БРАУЗЕР (watchPosition + Wake
// Lock), а не Telegram-бот: обмеження «фонова вкладка засинає» цей
// сценарій обходить, і зникає залежність від месенджера.
//
// Чому не перевикористали SalesTrip/SalesTrackPoint: там кожна точка
// вимагає tripId, а поїздка відкривається ботом по фото одометра. Водій
// нічого не фотографує і бота може не мати. Тут — вузькі власні моделі
// з тією самою математикою (metersFromPrev рахується при вставці).

/// Трек-сесія = один робочий день однієї людини.
///
/// Прив'язка до дня, а не до «поїздки»: планшет вмикається зранку і
/// гасне ввечері, проміжних старт/стопів немає. Роль не фіксуємо —
/// модель однаково обслуговує водія і торгового.
model TrackSession {
  id     String @id @default(cuid())
  userId String

  /// Київська дата, 00:00 — робочий день
  day DateTime

  startedAt   DateTime  @default(now())
  /// Час останньої прийнятої точки. Окреме поле, щоб «хто зараз онлайн»
  /// не сканував таблицю точок.
  lastPointAt DateTime?

  /// Лічильники накопичуються сервером при вставці пачки: звіт про день
  /// не має агрегувати сотні рядків заради двох чисел.
  pointsCount Int   @default(0)
  distanceKm  Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User         @relation("trackSessionUser", fields: [userId], references: [id], onDelete: Cascade)
  points TrackPoint[]

  /// День і людина однозначно визначають сесію — пачки точок роблять
  /// upsert по цьому ключу, і паралельні вкладки не створять дублів.
  @@unique([userId, day])
  @@index([day])
  @@index([lastPointAt])
}

/// Точка веб-треку. Свідомо вузька: день ≈ 100–300 точок на людину,
/// жодного зворотного геокодування при вставці.
model TrackPoint {
  id        String @id @default(cuid())
  sessionId String
  userId    String // денормалізовано: вибірка треку по людині без join

  lat Float
  lng Float

  /// Радіус похибки GPS, м. Точки з великою похибкою сервер відкидає:
  /// без цього поля «був за 300 м від клієнта» неможливо трактувати.
  accuracyM  Int?
  speedKmh   Int?
  headingDeg Int?

  /// Час з GPS-події на пристрої, а не час запису: пачка може приїхати
  /// через 20 хвилин офлайну, і createdAt збрехав би про момент.
  recordedAt DateTime

  metersFromPrev  Int?
  minutesFromPrev Int?

  /// Довжина відрізка ДОРОГОЮ, м — заповнюється лише для розривів треку
  /// (планшет був офлайн). metersFromPrev там — пряма через дахи, і саме
  /// вона занижувала пробіг: на реальному дні дві прямі дали 15,74 км із
  /// 15,76 км «пробігу». Коли поле заповнене, у пробіг іде воно.
  roadMetersFromPrev Int?

  /// Геометрія тієї дороги (GeoJSON LineString) — щоб карта малювала
  /// реальний шлях замість прямої лінії через півміста.
  gapGeometry Json?

  /// До якої зміни належить точка. Незалежно від доби: зміна може
  /// перетнути північ, і тоді її точки лежать у двох TrackSession, але
  /// в одному shiftId. Карта зміни фільтрує саме по ньому.
  shiftId String?
  /// У зміні точка чи після неї. null — старий трек водіїв, який про
  /// зміни нічого не знає.
  phase   TrackPhase?

  createdAt DateTime @default(now())

  session TrackSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation("trackPointUser", fields: [userId], references: [id], onDelete: Cascade)
  /// SetNull, а не Cascade: видалена зміна не має забирати з собою трек —
  /// точки лишаються свідченням про день.
  shift   Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([sessionId, recordedAt])
  @@index([userId, recordedAt])
  @@index([shiftId, recordedAt])
}

/// Чи потрапив на точку.
enum VisitStatus {
  DONE
  MISSED
}

/// Що з грошима на точці. NOT_APPLICABLE — боргу не було, забирати
/// нічого; окреме значення, щоб «нічого не забрав» не змішувалося з
/// «не було чого забирати».
enum MoneyCollected {
  FULL
  PARTIAL
  NONE
  NOT_APPLICABLE
}

/// Відмітка про візит до клієнта за день: приїхав / не потрапив,
/// коментар і скільки грошей забрав.
///
/// Дає те, чого не було ніде: факт відвідування з боку людини. Точки
/// маршрутного листа кажуть, куди ПЛАНУВАЛИ, трек — де БУВ, а Visit —
/// що там СТАЛОСЯ.
model Visit {
  id             String   @id @default(cuid())
  userId         String
  /// Київська дата візиту
  day            DateTime
  counterpartyId String

  /// Звідки взялася точка в списку дня. Обидва nullable: клієнта можна
  /// відмітити і поза планом (заїхав додатково).
  routeSheetStopId String?
  deliveryStopId   String?

  status  VisitStatus
  comment String?

  money MoneyCollected @default(NOT_APPLICABLE)

  /// Скільки забрав, ₴. При FULL сервер підставляє борг точки ЧИСЛОМ, а
  /// не посиланням: борг у 1С завтра зміниться, а відмітка має лишитися
  /// свідченням про той момент.
  collectedAmount Float?

  /// Де стояв планшет у мить відмітки — доказ присутності. Не блокуємо
  /// відмітку без геолокації (буває глухий підвал), але порожнє поле
  /// саме по собі інформативне.
  lat       Float?
  lng       Float?
  accuracyM Int?

  markedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation("visitUser", fields: [userId], references: [id], onDelete: Cascade)
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)

  /// Одна відмітка на клієнта за день: повторний тап редагує, а не
  /// плодить дублі. Ловить і гонку подвійного натискання на рівні БД.
  @@unique([userId, day, counterpartyId])
  @@index([day])
  @@index([counterpartyId, day])
}

/// Здача виручки водієм: водій каже «касу здав», офіс підтверджує прийом.
///
/// Visit каже, скільки водій ЗАБРАВ у клієнта, але не каже, чи ці гроші
/// доїхали до каси. Без окремого запису «на руках» рахувалося б вічно:
/// зібрав 4 320 — і назавжди винен, скільки б разів не здавав.
///
/// Дві сторони записані окремо навмисно: amount — те, що заявив водій,
/// confirmedAmount — те, що прийняв офіс. Розбіжність має бути видимою,
/// а не затертою одним полем.
model CashHandover {
  id       String @id @default(cuid())
  driverId String

  /// Київська доба, за яку здається виручка. Формат той самий, що у
  /// Visit.day, інакше звірка сум по дню розсиплеться.
  day DateTime

  /// Скільки водій заявив, ₴
  amount Float

  /// Скільки було «на руках» за відмітками в мить здачі — числом, а не
  /// перерахунком: завтра відмітки можуть зміститися, а розбіжність тієї
  /// здачі має лишитися такою, якою її бачили обидві сторони.
  expectedAmount Float?

  comment  String?
  handedAt DateTime @default(now())

  /// Підтвердження прийому офісом. Поки null — гроші рахуються в дорозі.
  confirmedAt   DateTime?
  confirmedById String?

  /// Фактично прийнята сума, якщо розійшлася із заявленою.
  confirmedAmount Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver User @relation("cashHandoverDriver", fields: [driverId], references: [id], onDelete: Cascade)

  /// SetNull: звільнений касир не має забирати з собою історію здач.
  confirmedBy User? @relation("cashHandoverConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  /// Без @@unique по дню навмисно: здають і в обід, і ввечері.
  @@index([driverId, day])
  @@index([day])
  @@index([confirmedAt])
}

/// Токен пристрою для нативного застосунку торгового.
///
/// Веб шле точки під cookie NextAuth, і для планшета в тримачі це
/// працює: браузер відкритий, сесія жива. Але фонова служба Android
/// мусить слати координати місяцями без жодного дотику до екрана, а
/// cookie протухає — торговий вилітав би посеред дня, і трек губився б
/// саме тоді, коли ніхто не дивиться.
///
/// Тому пристрій отримує окремий довгий токен: логін один раз при
/// видачі планшета. У базі лежить лише SHA-256 — витік дампа не дає
/// доступу до заливки координат.
model DeviceToken {
  id     String @id @default(cuid())
  userId String

  /// Для чого виданий токен: "track" — планшет торгового чи водія,
  /// "shop" — застосунок покупця.
  ///
  /// Один контур перевірки на два різні застосунки був би дірою: токен,
  /// виданий покупцеві, ходив би в /api/track/points і /api/shift/*. Тому
  /// кожна сторона перевіряє свою область явно, а не покладається на роль:
  /// ADMIN і MANAGER присутні в обох списках ролей.
  scope String @default("track")

  /// SHA-256 від токена у hex. Сам токен існує лише на пристрої.
  tokenHash String @unique

  /// Модель планшета — щоб адмін бачив, який саме пристрій відкликає.
  deviceName String?

  /// Останнє використання: мертвий пристрій видно без перегляду точок.
  lastUsedAt DateTime?

  /// Відкликання: втрачений планшет або звільнений торговий. Рядок не
  /// видаляємо, щоб лишалась історія, у кого і коли був пристрій.
  revokedAt DateTime?

  createdAt DateTime @default(now())

  user       User              @relation("deviceTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  heartbeats DeviceHeartbeat[] @relation("heartbeatToken")

  @@index([userId])
  @@index([userId, scope])
}

/// Пульс планшета: що застосунок каже про себе сам.
///
/// Досі про трекер було відомо рівно стільки, скільки він надіслав точок.
/// А коли точок немає, розрізнити «служба мертва», «дозвіл забрали»,
/// «GPS не бачить неба» і «планшет вимкнули» не було чим — кожен розбір
/// упирався в здогади. Показовий випадок: 26.08 у торгового за 205 хвилин
/// зміни в базі лежала ОДНА точка, і з'ясувати причину з сервера було
/// неможливо в принципі.
///
/// Пульс приходить раз на кілька хвилин НАВІТЬ із порожнім буфером. Тому
/// мовчання в цій таблиці саме по собі — діагноз: застосунок не працює.
/// Рядки не оновлюються, а дописуються: історія «коли саме служба стояла»
/// цінніша за поточний стан, який і так видно з останнього рядка.
model DeviceHeartbeat {
  id         String  @id @default(cuid())
  userId     String
  /// З якого пристрою. Токен могли відкликати — історію це не забирає.
  tokenId    String?
  deviceName String?

  /// Час сервера: саме за ним рахується «мовчить N хвилин».
  at         DateTime  @default(now())
  /// Час на пристрої. Розбіжність із at ловить збитий годинник — через
  /// нього точки лягали б у чужу добу й ніхто б не зрозумів чому.
  reportedAt DateTime?

  /// Чи працює служба відстеження цієї миті.
  tracking  Boolean @default(false)
  /// SHIFT | AFTER_SHIFT | IDLE — у якому режимі вона зараз.
  mode      String?
  /// Чи відкрита зміна за даними пристрою. Розбіжність із сервером
  /// означає, що планшет живе застарілою картиною.
  shiftOpen Boolean @default(false)

  /// Скільки точок чекає відправки. Росте — зв'язку немає, але трек
  /// пишеться; стоїть на нулі при мертвому GPS — фіксів немає взагалі.
  buffered Int @default(0)

  /// Останній фікс GPS і його похибка — видно, чи є небо.
  lastFixAt        DateTime?
  lastFixAccuracyM Int?
  /// Остання вдала відправка на сервер.
  lastSyncAt       DateTime?
  /// Остання помилка, як її бачив пристрій.
  lastError        String?

  /// Три причини, через які трек тихо вмирає, — і жодної з них не було
  /// видно з сервера.
  /// ALWAYS | WHILE_USING | DENIED
  locationPermission String?
  /// true — Android має право прибити службу заради батареї.
  batteryOptimized   Boolean?
  batteryPct         Int?
  /// GPS | NETWORK | OFF — стан системного перемикача локації.
  locationMode       String?

  /// Версія збірки: без неї «у нас це вже виправлено» неперевірне.
  appVersion String?

  user  User         @relation("heartbeatUser", fields: [userId], references: [id], onDelete: Cascade)
  token DeviceToken? @relation("heartbeatToken", fields: [tokenId], references: [id], onDelete: SetNull)

  /// Основний запит — «останній пульс людини» і стрічка за день.
  @@index([userId, at])
  /// Хто взагалі мовчить: скан по часу без прив'язки до людини.
  @@index([at])
}

/// Пристрій, якому можна слати пуш про замовлення.
///
/// Рядок Notification у базі вже створюється при зміні статусу, але покупець
/// його ніде не бачить: дзвіночок є лише в адмінці й кабінетах персоналу.
/// Ця таблиця — адреса доставки для тих самих подій.
model PushToken {
  id String @id @default(cuid())

  userId String

  /// ExponentPushToken[...] — адреса в Expo Push Service, який сам ходить в
  /// APNs і FCM. Unique, бо перевстановлення застосунку видає новий токен, а
  /// старий може ще раз приїхати від того ж пристрою.
  token String @unique

  platform String /// ios | android

  /// Версія збірки — щоб знати, кому пуш із новим полем ще не зрозумілий.
  appVersion String?

  /// Expo відповідає DeviceNotRegistered, коли застосунок знесли. Рядок не
  /// видаляємо, щоб не слати в ту саму мертву адресу знову й знову.
  revokedAt DateTime?

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  user User @relation("pushTokenUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Обране покупця — на сервері, а не в localStorage.
///
/// На сайті обране живе в браузері (budvik_wishlist) і зникає разом із кукі.
/// Застосунок обіцяє показувати обране офлайн, тож воно мусить переживати
/// перевстановлення — а заразом підтягується й на сайті, коли людина заходить
/// із того самого акаунта.
model WishlistItem {
  id String @id @default(cuid())

  userId    String
  productId String

  createdAt DateTime @default(now())

  user User @relation("wishlistUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

/// Лічильник частоти запитів.
///
/// Потрібен, бо префікс /api/v1/ винесено з-під челенджу Vercel: без нього
/// підбір пароля на /api/v1/auth/login не має жодної стелі. Стеля на межі
/// мережі (правило Rate Limit у фаєрволі) дешевша — вона гасить зловживання
/// до платного виклику функції, — але вона в дашборді, а не в репозиторії, і
/// цей рядок захисту не має залежати від того, чи її не забули налаштувати.
///
/// Один рядок на ключ, а не рядок на запит: інакше таблиця росла б зі
/// швидкістю трафіку й потребувала б постійного прибирання.
model RateLimit {
  /// Наприклад "login:ip:1.2.3.4" або "login:email:hto@example.com".
  key String @id

  count Int @default(0)

  /// Початок поточного вікна. Старіше за вікно — лічильник починається заново.
  windowAt DateTime @default(now())
}

/// Стан зміни торгового.
enum ShiftStatus {
  OPEN /// відкрита: фото стартового одометра підтверджене, трек пишеться
  CLOSED /// закрита нормально — обидва одометри є, пробіг порахований
  ABANDONED /// торговий забув закрити; пробіг узято зі старту наступної зміни
}

/// До чого належить точка треку.
enum TrackPhase {
  SHIFT /// у робочій зміні
  AFTER_SHIFT /// після закриття зміни — «чи не таксував»
}

/// Робоча зміна торгового: від фото одометра до фото одометра.
///
/// Свідомо окрема модель, а не SalesTrip. Та наполовину телеграмна —
/// startTelegramFileId, liveMessageId, liveChatId, — і половина її полів
/// у застосунку лишалася б мертвою. До того ж її трек живе в
/// SalesTrackPoint(tripId), а застосунок пише в TrackPoint. Бот тим
/// часом продовжує писати у свою модель, і цифри в його звітах не
/// попливуть.
///
/// Поля day немає навмисно: зміна може перетнути північ, і прив'язка до
/// доби зробила б із неї дві. Точки належать добі (через TrackSession) і
/// зміні (через shiftId) незалежно.
model Shift {
  id     String      @id @default(cuid())
  userId String
  status ShiftStatus @default(OPEN)

  // --- Відкриття ---
  startedAt DateTime @default(now())
  startLat  Float?
  startLng  Float?

  /// Показання одометра. Int, а не Float: одометри цілочисельні в км, а
  /// Float спокушає AI повернути 123456.7 з добового лічильника (TRIP).
  startOdometer           Int
  startOdometerSource     OdometerSource
  /// Що сказав AI до правки людини — метрика якості моделі
  startOdometerAiValue    Int?
  startOdometerConfidence Float?
  startPhotoUrl           String?
  startPhotoKey           String?
  /// SHA-256 фото: заміна telegramFileId. Той самий знімок удруге —
  /// привід придивитися, а не технічна помилка.
  startPhotoSha256        String?
  startConfirmedAt        DateTime?

  // --- Закриття ---
  endedAt               DateTime?
  endLat                Float?
  endLng                Float?
  endOdometer           Int?
  endOdometerSource     OdometerSource?
  endOdometerAiValue    Int?
  endOdometerConfidence Float?
  endPhotoUrl           String?
  endPhotoKey           String?
  endPhotoSha256        String?
  endConfirmedAt        DateTime?

  // --- Похідні ---
  /// endOdometer - startOdometer
  distanceKm         Int?
  durationMinutes    Int?
  /// Пробіг за GPS-треком зміни — завжди НИЖЧА межа: трек іде по прямій
  /// між точками, дорога довша.
  gpsDistanceKm      Float?
  /// Одометр / GPS. ~1.2-1.6 — норма; сильно більше означає, що
  /// кілометри були, а треку до них немає.
  odometerToGpsRatio Float?
  /// Кілометри між кінцем минулої зміни й початком цієї. НЕ порушення
  /// саме собою: дорога додому теж рахується.
  personalKm         Int?
  /// Різниця від'ємна, нульова або неправдоподібна
  odometerSuspicious Boolean @default(false)

  // --- Забута зміна ---
  /// Закрита автоматично при відкритті наступної, а не людиною
  closedAutomatically Boolean @default(false)
  /// Яка саме зміна її закрила — щоб було видно ланцюжок
  autoClosedByShiftId String?

  /**
   * Зміна закрита заднім числом, без фінішного фото.
   * Реальний випадок: торговий згадав про незакриту зміну ввечері вдома,
   * коли машина вже у дворі. Фото одометра зробити нема як — цифра на
   * ньому вже інша. Але час закінчення роботи він пам'ятає, і трек за
   * той вечір є, тож робочі кілометри ще можна відділити від дороги
   * додому. Одометр підтягнеться зранку зі старту наступної зміни.
   */
  closedLate Boolean @default(false)

  /**
   * Звідки взявся endedAt у пізньому закритті: GPS (запропонував
   * застосунок за моментом, коли машина стала надовго) чи людина
   * вказала руками. Різниця важлива при розборі: підказці GPS можна
   * вірити більше.
   */
  lateCloseSource String?

  /**
   * Кілометри після фактичного завершення роботи — дорога додому й усе,
   * що було потім. Рахуються за GPS від endedAt до старту наступної
   * зміни: одометр цього розділити не вміє, він знає лише підсумок.
   */
  afterWorkKm Float?

  /// Ключ ідемпотентності від пристрою: повтор запиту після таймауту
  /// має віддати ту саму зміну, а не створити другу.
  clientRequestId String? @unique

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User                @relation("shiftUser", fields: [userId], references: [id], onDelete: Cascade)
  points TrackPoint[]
  reads  ShiftOdometerRead[]

  @@index([userId, startedAt])
  @@index([status])
}

/// Кожна спроба розпізнати одометр — навіть та, що не стала зміною.
///
/// Фото завантажується й розпізнається ДО створення зміни: інакше
/// перефотографування плодило б порожні зміни. Заразом це єдиний спосіб
/// побачити, скільки разів торговий перезнімав, поки не «вийшло
/// потрібне число».
model ShiftOdometerRead {
  id      String  @id @default(cuid())
  shiftId String?
  userId  String

  /// START або END — для якого краю зміни знімок
  phase String

  photoUrl    String?
  photoKey    String?
  photoSha256 String?

  aiValue        Int?
  aiConfidence   Float?
  /// Цифри так, як їх побачила модель: «0 9 1 3 0 0» — за ними видно,
  /// де саме вона помилилася.
  aiDigitsRead   String?
  aiIsTripMeter  Boolean @default(false)
  /// Чому вердикт негативний: not_read, trip_meter, too_far…
  rejectedReason String?
  /// Повна відповідь моделі — для розбору польотів
  rawJson        Json?

  createdAt DateTime @default(now())

  shift Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([shiftId])
}

/// Подія відвідувача сайту: вебаналітика магазину.
///
/// Не плутати з Visit (візит торгового до контрагента) і з TrackPoint
/// (GPS водія) — це різні світи, спільна лише назва «відвідування».
///
/// Пишеться пачками з браузера через /api/site-events. Ідентифікація
/// анонімна й ЛИШЕ через localStorage: кука тут заборонена, бо читання
/// cookies у серверному компоненті вимикає ISR каталогу — саме на цьому
/// раніше згорів рахунок Vercel.
model SiteEvent {
  id String @id @default(cuid())

  /// Анонімний id відвідувача з localStorage (bv_vid). Живе, поки живе
  /// сховище браузера; чистка кешу = новий «відвідувач».
  visitorId String
  /// Id сесії (bv_sid). Обривається після 30 хвилин без подій.
  sessionId String
  /// Хто це був, якщо залогінений. Без FK: подія — це історія, вона
  /// мусить пережити видалення користувача.
  userId    String?

  /// page_view | product_view | search | add_to_cart | add_to_wishlist |
  /// add_to_compare | order_placed | phone_click
  ///
  /// «Відкрив оформлення» окремою подією не пишемо — це page_view із
  /// path = /checkout.
  type String

  /// Шлях сторінки без query-рядка
  path      String?
  /// Товар події. Без FK — щоб інжест не ходив у базу перевіряти; у
  /// звітах приєднується через LEFT JOIN.
  productId String?
  /// Пошуковий запит у нижньому регістрі
  query     String?
  /// Уточнення: для phone_click — вид контакту (tel/mailto/viber/telegram),
  /// для order_placed — id замовлення
  label     String?
  /// Число події: к-ть знайдених товарів для search (0 = запит без
  /// результатів), кількість для add_to_cart, сума для order_placed
  value     Int?

  /// Хост, звідки прийшли. Пишеться лише на першій сторінці сесії:
  /// далі реферером був би наш власний сайт.
  referrer String?
  /// Код торгового з QR-переходу (кука budvik_ref). Читається на інжесті —
  /// цей роут не кешується, тож ISR не зачіпає.
  refCode  String?

  /// mobile | desktop — з User-Agent на сервері
  device  String?
  /// Chrome | Safari | Firefox | Edge | Opera | інше
  browser String?
  /// Країна й місто з заголовків Vercel. Безкоштовно й без сторонніх
  /// сервісів; на локальній машині лишаються порожні.
  country String?
  city    String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([sessionId])
  @@index([productId, type])
}

/// Денний зріз вебаналітики за київською добою.
///
/// Живе вічно, тоді як сирі SiteEvent чистяться через 180 днів: графік
/// «скільки людей заходило торік» мусить лишитися, а мільйони рядків
/// заради нього тримати нема сенсу.
model SiteDailyStat {
  id   String   @id @default(cuid())
  date DateTime @unique @db.Date

  /// Унікальні visitorId за добу
  visitors     Int @default(0)
  sessions     Int @default(0)
  pageViews    Int @default(0)
  productViews Int @default(0)
  searches     Int @default(0)
  addToCarts   Int @default(0)
  ordersPlaced Int @default(0)
  phoneClicks  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
