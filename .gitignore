# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
dev.db
dev.db-journal

# migration data
scripts/sitemap-products.json

# логіни й паролі торгових для set-rep-credentials.ts
creds*.txt

# бекапи залишків від zero-stock-not-in-1c.mjs (мегабайти даних, не код)
scripts/backup-stock-not-in-1c-*.json

# макети й скріншоти: 22 МБ проти 16 МБ усього репозиторію, і git тримав би
# їх в історії назавжди — видалення потім ваги не повертає. Обмін макетами
# через Google Drive; вихідник Budvik27.pen легкий і лежить у git.
design/

# Застосунок покупця (Expo).
# Теки ios/ і android/ генерує `expo prebuild` з app.json — тримати їх у git
# означало б розвʼязувати конфлікти в згенерованих файлах на кожен реліз.
/mobile/node_modules
/mobile/.expo
/mobile/ios
/mobile/android
/mobile/dist

# Збірка застосунку покупця. У git не тримаємо: Expo APK важить понад сто
# мегабайтів, GitHub відмовляє в файлах понад сто, а бінарник на кожен реліз
# зробив би репозиторій неклонованим. Файл живе в R2, роздає /api/app/shop/*.
# Трекер (BudvikTracker.apk, 8 МБ) лишається в git — він на два порядки менший.
/assets/app/Budvik27*.apk
output/grosser-catalog/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/.playwright/
