{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/webstats-rollup",
      "schedule": "30 1 * * *"
    }
  ],
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- ':(exclude)scripts' ':(exclude)output' ':(exclude)design' ':(exclude)worker' ':(exclude)agent' ':(exclude)mobile' ':(exclude)railway.json' ':(exclude).railwayignore' ':(exclude).nvmrc' ':(exclude)*.md'"
}
